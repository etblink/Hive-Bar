{
  "name": "hive-bar",
  "version": "0.1.0",
  "description": "A focused Hive community experience for 4th Street Bar.",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "npm run build:css && node --watch src/server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --watch",
    "smoke:live": "node scripts/live-read-smoke.js",
    "lint": "eslint src routes public/js test scripts index.js eslint.config.js --max-warnings=0",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 test/*.test.js",
    "check:secrets": "node scripts/check-secrets.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run check:secrets && npm run lint && npm run build && npm test && npm run audit:prod"
  },
  "dependencies": {
    "compression": "1.8.1",
    "dotenv": "17.4.2",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "htmx.org": "2.0.10",
    "hive-tx": "7.2.0",
    "markdown-it": "15.0.0",
    "pino": "10.3.1",
    "sanitize-html": "2.17.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "axe-core": "4.13.0",
    "eslint": "10.0.0",
    "html-validate": "11.6.2",
    "jsdom": "29.1.1",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3"
  },
  "packageManager": "npm@11.9.0"
}
