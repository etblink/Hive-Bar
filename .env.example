NODE_ENV=development
PORT=3000
# Privex production binds Node to loopback behind Caddy.
BIND_HOST=127.0.0.1
SITE_NAME=4th Street Bar
BAR_ADDRESS=1114 E. 4th Street, Reno, NV 89512
BAR_PHONE=(775) 324-7827
BAR_HOURS=Daily, 12:00 p.m.–2:00 a.m.
BAR_WEBSITE_URL=https://4thstreetbarreno.com/
BAR_MAP_URL=https://www.google.com/maps/search/?api=1&query=1114%20E.%204th%20Street%2C%20Reno%2C%20NV%2089512
HIVE_COMMUNITY_ID=hive-108590
THREADS_CONTAINER_ACCOUNT=fourthst.threads
HIVE_RPC_NODES=https://api.hive.blog,https://api.deathwing.me,https://api.openhive.network
# Deployment baseline: disabled/disabled. Accepted production beta: beta/keychain.
# M17.4 preserves the wired but not production-activated production/keychain V1 profile.
HIVE_WRITE_MODE=disabled
HIVE_SIGNER_MODE=disabled
# M19.3 in-person onboarding is a separate staff Keychain capability and remains off until explicit activation.
HIVE_ONBOARDING_ENABLED=false
HIVE_ONBOARDING_CREATOR_ACCOUNT=
# Fixed starter delegation expressed as Hive Power, not a fiat-value peg.
HIVE_ONBOARDING_STARTER_HP=5.000
HIVE_ONBOARDING_REQUEST_TTL_MS=900000
# Keep both controlled-lane settings explicitly empty in read-only, beta, and V1 self-signing modes.
HIVE_CONTROLLED_ACCOUNTS=
HIVE_CONTROLLED_ACTIONS=
HIVE_WALL_DEFAULT_FEE=1.000 HBD
# Comma-separated server-wide sender exclusions. Empty unless explicitly configured.
HIVE_GLOBAL_WALL_EXCLUSIONS=
HIVE_MESSAGE_HISTORY_PAGE_SIZE=25
# C2-E merchant-local moderation is separate from Hive write modes and is off until durable storage/operator activation.
HIVE_MODERATION_ENABLED=false
HIVE_MODERATION_OPERATOR_ACCOUNTS=
HIVE_MODERATION_DB_PATH=:memory:
# Pay broadcasts remain outside beta and V1 self-signing.
HIVE_PAYMENT_MERCHANT_ACCOUNTS=fourthstreetbar
HIVE_PAYMENT_MAX_HBD=1.000 HBD
# :memory: is inert in read-only/beta/V1 self-signing; controlled payment requires a durable path.
HIVE_PAYMENT_RECEIPT_DB_PATH=:memory:
HIVE_PAYMENT_CONFIRMATION_TIMEOUT_MS=120000
# Distriator remains a separate commercial lane.
DISTRIATOR_ENABLED=false
DISTRIATOR_CLAIM_URL=https://distriator.com/#/claim
HIVE_APP_TAG=fourth-street-bar-app/0.1.0
HIVE_RPC_TIMEOUT_MS=8000
HIVE_RPC_FAILURE_THRESHOLD=2
HIVE_RPC_COOLDOWN_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
APP_ORIGIN=http://localhost:3000
# Required in production; use at least 32 random bytes and never commit it.
SESSION_SECRET=
SESSION_TTL_MS=28800000
AUTH_CHALLENGE_TTL_MS=300000
SOCIAL_PREFLIGHT_TTL_MS=300000
# Set explicitly for the actual TLS/proxy topology before public release.
TRUST_PROXY=false
LOG_LEVEL=info
