# Install as /etc/hive-bar/hive-bar.env with owner root:hivebar and mode 0640.
# The service account needs group-read access for pre-activation release gates.
NODE_ENV=production
PORT=3000
BIND_HOST=127.0.0.1
HIVE_BAR_HOST=fourthstreetbar.com
SITE_NAME="4th Street Bar"
BAR_ADDRESS="1114 E. 4th Street, Reno, NV 89512"
BAR_PHONE="(775) 324-7827"
BAR_HOURS="Daily, 12:00 p.m.–2:00 a.m."
BAR_WEBSITE_URL=https://4thstreetbarreno.com/
BAR_MAP_URL="https://www.google.com/maps/search/?api=1&query=1114%20E.%204th%20Street%2C%20Reno%2C%20NV%2089512"
HIVE_COMMUNITY_ID=hive-108590
HIVE_OFFICIAL_BAR_ACCOUNT=fourthstreetbar
THREADS_CONTAINER_ACCOUNT=fourthst.threads
HIVE_RPC_NODES=https://api.hive.blog,https://api.deathwing.me,https://api.openhive.network
# Exact source deployment always starts from read-only.
# Accepted beta uses beta/keychain; future V1 activation uses production/keychain only after separate authorization.
HIVE_WRITE_MODE=disabled
HIVE_SIGNER_MODE=disabled
# C2-F/C2-F.1 source contains durable onboarding policy, but production remains disabled until separate activation authorization.
HIVE_ONBOARDING_ENABLED=false
# Accepted venue policy: @fourthstreetbar is the production creator. This source example does not activate it.
HIVE_ONBOARDING_CREATOR_ACCOUNT=fourthstreetbar
# Merchant-configurable fee and starter delegation; 4th Street Bar beta defaults shown here.
HIVE_ONBOARDING_CASH_FEE_USD=5.00
HIVE_ONBOARDING_STARTER_HP=5.000
# Hive-Bar hard floor: at least 10.000 HP must remain after the proposed starter delegation.
# A venue may raise this reserve but may not configure it below 10.000 HP.
HIVE_ONBOARDING_MIN_REMAINING_HP=10.000
# Merchant-configurable low inventory warning. Zero ACT remains a hard stop.
HIVE_ONBOARDING_LOW_ACT_THRESHOLD=3
HIVE_ONBOARDING_REQUEST_TTL_MS=900000
HIVE_ONBOARDING_DB_PATH=/var/lib/hive-bar/onboarding/onboarding.sqlite3
# Scalable guardrails: these are beta defaults and may be raised deliberately within validated configuration bounds.
HIVE_ONBOARDING_REQUEST_RATE_WINDOW_MS=60000
HIVE_ONBOARDING_REQUEST_RATE_MAX=5
HIVE_ONBOARDING_MAX_LIVE_REQUESTS=25
HIVE_ONBOARDING_MAX_DAILY_REQUESTS=50
# Controlled/operator lanes remain explicitly inert in read-only, beta, and V1 self-signing profiles.
HIVE_CONTROLLED_ACCOUNTS=
HIVE_CONTROLLED_ACTIONS=
HIVE_WALL_DEFAULT_FEE="1.000 HBD"
HIVE_GLOBAL_WALL_EXCLUSIONS=
HIVE_MESSAGE_HISTORY_PAGE_SIZE=25
# C2-E remains dormant until storage is provisioned and a separate production activation sets these values.
HIVE_MODERATION_ENABLED=false
HIVE_MODERATION_OPERATOR_ACCOUNTS=
HIVE_MODERATION_DB_PATH=/var/lib/hive-bar/moderation/moderation.sqlite3
HIVE_PAYMENT_MERCHANT_ACCOUNTS=fourthstreetbar
HIVE_PAYMENT_MAX_HBD="1.000 HBD"
HIVE_PAYMENT_RECEIPT_DB_PATH=:memory:
HIVE_PAYMENT_CONFIRMATION_TIMEOUT_MS=120000
# Payments/Distriator remain separate from patron-facing beta/V1 self-signing.
DISTRIATOR_ENABLED=false
DISTRIATOR_CLAIM_URL="https://distriator.com/#/claim"
HIVE_APP_TAG=fourth-street-bar-app/0.1.0
HIVE_RPC_TIMEOUT_MS=8000
HIVE_RPC_FAILURE_THRESHOLD=2
HIVE_RPC_COOLDOWN_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
APP_ORIGIN=https://fourthstreetbar.com
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_TTL_MS=28800000
AUTH_CHALLENGE_TTL_MS=300000
SOCIAL_PREFLIGHT_TTL_MS=300000
TRUST_PROXY=loopback
LOG_LEVEL=info
