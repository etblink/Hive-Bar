#!/bin/sh
set -eu

response="$(curl --fail --silent --show-error --max-time 5 http://127.0.0.1:3000/healthz)"

case "$response" in
  *'"status":"ok"'*'"writeMode":"disabled"'*)
    exit 0
    ;;
  *)
    logger -p daemon.err -t hive-bar-healthcheck 'Unexpected local health response'
    exit 1
    ;;
esac
