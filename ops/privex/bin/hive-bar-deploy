#!/bin/bash
set -Eeuo pipefail
umask 027

readonly app_root=/opt/hive-bar
readonly repository="$app_root/repository.git"
readonly releases="$app_root/releases"
readonly current="$app_root/current"
readonly environment_file=/etc/hive-bar/hive-bar.env
readonly runtime=/usr/local/bin/node
readonly npm_runtime=/usr/local/bin/npm
readonly service=hive-bar.service
readonly health_url=http://127.0.0.1:3000/healthz

staging=

fail() {
  printf 'Hive-Bar deploy refused: %s\n' "$1" >&2
  exit 1
}

cleanup() {
  if [[ -n "$staging" && -d "$staging" && "$staging" == "$releases"/.staging.* ]]; then
    rm -rf -- "$staging"
  fi
}
trap cleanup EXIT

[[ $EUID -eq 0 ]] || fail 'run as root'
[[ $# -eq 1 ]] || fail 'provide exactly one full 40-character commit SHA'
commit="$1"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail 'commit must be 40 lowercase hexadecimal characters'
[[ -d "$repository" ]] || fail 'the reviewed bare repository is missing'
[[ -r "$environment_file" ]] || fail 'the protected environment file is missing'
[[ "$(stat -c '%U:%G:%a' "$environment_file")" == 'root:hivebar:640' ]] || fail 'the environment file must be root:hivebar mode 0640'
[[ -x "$runtime" ]] || fail 'the pinned Node runtime is missing'
[[ -x "$npm_runtime" ]] || fail 'the pinned npm runtime is missing'
[[ "$($runtime --version)" == 'v24.19.0' ]] || fail 'the Node runtime is not v24.19.0'
[[ "$($npm_runtime --version)" == '11.17.0' ]] || fail 'the npm runtime is not 11.17.0'
[[ -d "$releases" ]] || fail 'the release directory is missing'

git --git-dir="$repository" cat-file -e "${commit}^{commit}" 2>/dev/null || fail 'commit is absent from the reviewed repository'
resolved_commit="$(git --git-dir="$repository" rev-parse "${commit}^{commit}")"
[[ "$resolved_commit" == "$commit" ]] || fail 'commit did not resolve exactly'
tree="$(git --git-dir="$repository" rev-parse "${commit}^{tree}")"
release="$releases/$commit"

if [[ ! -d "$release" ]]; then
  staging="$(mktemp -d "$releases/.staging.${commit}.XXXXXX")"
  git --git-dir="$repository" archive --format=tar "$commit" | tar -xf - -C "$staging"
  chown -R hivebar:hivebar "$staging"
  install -d -o hivebar -g hivebar -m 0700 "$staging/.deploy-home"

  runuser -u hivebar -- env -i \
    HOME="$staging/.deploy-home" PATH=/usr/local/bin:/usr/bin:/bin \
    sh -c '
    set -eu
    cd "$1"
    node scripts/check-pinned-runtime.js
    npm ci --ignore-scripts --no-audit --no-fund
    npx --no-install patch-package
    npm run build
    npm prune --omit=dev --ignore-scripts --no-audit --no-fund
    npm ls --omit=dev --all >/dev/null
  ' sh "$staging"

  runuser -u hivebar -- env -i HOME=/nonexistent PATH=/usr/local/bin:/usr/bin:/bin sh -c '
    set -eu
    set -a
    . /etc/hive-bar/hive-bar.env
    set +a
    PATH=/usr/local/bin:/usr/bin:/bin
    export PATH
    cd "$1"
    node scripts/check-privex-release.js
  ' sh "$staging"

  rm -rf -- "$staging/.deploy-home"
  printf '%s\n' "$commit" >"$staging/.hive-bar-commit"
  printf '%s\n' "$tree" >"$staging/.hive-bar-tree"
  chown -R root:hivebar "$staging"
  chmod -R go-w "$staging"
  chmod 0750 "$staging"
  mv -T "$staging" "$release"
  staging=
fi

[[ "$(stat -c '%U:%G:%a' "$release")" == 'root:hivebar:750' ]] || fail 'the installed release root ownership or mode is unsafe'
runuser -u hivebar -- /usr/bin/test -x "$release" || fail 'the hivebar service account cannot traverse the installed release'
runuser -u hivebar -- /usr/bin/test -r "$release/scripts/start-privex.js" || fail 'the hivebar service account cannot read the installed startup entrypoint'
[[ -r "$release/.hive-bar-commit" ]] || fail 'stored release commit identity is missing'
[[ -r "$release/.hive-bar-tree" ]] || fail 'stored release tree identity is missing'
[[ "$(<"$release/.hive-bar-commit")" == "$commit" ]] || fail 'stored release commit does not match'
[[ "$(<"$release/.hive-bar-tree")" == "$tree" ]] || fail 'stored release tree does not match'
previous="$(readlink -f "$current" 2>/dev/null || true)"
next_link="$app_root/.current.${commit}.$$"
ln -s "$release" "$next_link"
mv -Tf "$next_link" "$current"

systemctl restart "$service"
for _attempt in {1..20}; do
  if curl --fail --silent --show-error --max-time 5 "$health_url" | grep -Fq '"writeMode":"disabled"'; then
    printf 'Hive-Bar deployed exact commit %s (tree %s).\n' "$commit" "$tree"
    exit 0
  fi
  sleep 1
done

if [[ -n "$previous" && -d "$previous" ]]; then
  recovery_link="$app_root/.current.recovery.$$"
  ln -s "$previous" "$recovery_link"
  mv -Tf "$recovery_link" "$current"
  systemctl restart "$service"
fi
fail 'post-switch health check failed; the previous release was restored when available'
