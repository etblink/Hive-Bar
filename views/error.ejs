<!doctype html>
<html lang="en">
<head>
  <%- include('common/head') %>
</head>
<body class="flex min-h-screen flex-col bg-black text-white">
  <%- include('common/header') %>
  <main class="container mx-auto flex flex-1 items-center justify-center px-6 py-16">
    <section class="w-full max-w-2xl rounded-xl border border-gray-700 bg-gray-900 p-8 text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-bar-gold"><%= statusCode %> · <%= errorCode %></p>
      <h1 class="mt-3 text-3xl font-bold"><%= pageTitle %></h1>
      <p class="mt-4 text-gray-300"><%= message %></p>
      <p class="mt-4 text-xs text-gray-500">Reference: <%= requestId %></p>
      <a href="/" class="mt-6 inline-block rounded bg-bar-gold px-5 py-3 font-bold text-black hover:bg-yellow-500">Return home</a>
    </section>
  </main>
  <%- include('common/footer') %>
</body>
</html>
