<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../common/head') %>
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/c2-b-focused.css') : '/css/c2-b-focused.css' %>">
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/c2-b3-social.css') : '/css/c2-b3-social.css' %>">
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/c2-d-media.css') : '/css/c2-d-media.css' %>">
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/c2-e-moderation.css') : '/css/c2-e-moderation.css' %>">
</head>
<body class="flex min-h-screen flex-col">
  <%- include('../../common/header') %>
  <main id="main-content" class="conversation-shell" data-m15-surface="conversation">
    <div class="conversation-column">
      <nav aria-label="Breadcrumb">
        <a href="/community" class="conversation-back"><span aria-hidden="true">←</span> Community</a>
      </nav>
      <%- include('../../partials/full-post') %>
    </div>
  </main>
  <%- include('../../common/footer') %>
  <script src="<%= typeof assetUrl === 'function' ? assetUrl('/js/moderation.js') : '/js/moderation.js' %>" defer></script>
</body>
</html>
