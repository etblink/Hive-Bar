<section class="pay-receipt <%= receiptClass %>" aria-labelledby="receipt-heading" data-pay-receipt hidden>
  <div class="pay-step-heading">
    <span aria-hidden="true">2</span>
    <div>
      <p class="app-kicker">Durable receipt</p>
      <h2 id="receipt-heading">Receipt &amp; chain confirmation</h2>
    </div>
  </div>

  <p class="pay-receipt__state" aria-live="polite" data-pay-receipt-state></p>

  <dl class="pay-receipt__evidence grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div><dt>Payer</dt><dd data-pay-receipt-account></dd></div>
    <div><dt>Merchant</dt><dd data-pay-receipt-merchant></dd></div>
    <div><dt>Amount</dt><dd data-pay-receipt-amount></dd></div>
    <div><dt>Block</dt><dd data-pay-receipt-block>Pending</dd></div>
    <div class="sm:col-span-2"><dt>Transaction ID</dt><dd class="pay-proof" data-pay-receipt-transaction>Pending</dd></div>
    <div class="sm:col-span-2"><dt>Operation fingerprint</dt><dd class="pay-proof" data-pay-receipt-fingerprint></dd></div>
  </dl>

  <p class="pay-receipt__message" data-pay-receipt-message></p>
  <p class="pay-receipt__caution"><strong>Do not pay again while this receipt is pending or ambiguous.</strong> A recheck observes the existing transaction; it does not create another transfer.</p>
  <button type="button" class="button-secondary pay-recheck" data-pay-recheck hidden>Recheck Hive — do not pay again</button>

  <% if (distriator.enabled) { %>
    <div class="pay-external-claim" data-pay-rebate hidden>
      <p class="app-kicker">Separate external service</p>
      <h3>External rebate claim</h3>
      <p>Distriator has its own eligibility, documentation, timing, review, and payout rules. Hive-Bar does not promise a percentage or track claim completion.</p>
      <a class="button-secondary" href="<%= distriator.claimUrl %>" target="_blank" rel="noopener noreferrer" data-distriator-claim>Open official Distriator claim</a>
    </div>
  <% } else { %>
    <p class="pay-external-disabled">Distriator remains disabled and outside this payment acceptance flow.</p>
  <% } %>

  <p class="pay-receipt__merchant-note">This Hive-Bar receipt is user-facing evidence and does not replace the merchant's V4V/POS reconciliation.</p>
</section>
