<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../common/head') %>
  <link rel="stylesheet" href="/css/m15-wallet-pay.css">
</head>
<body class="flex min-h-screen flex-col bg-black text-white">
  <%- include('../../common/header') %>
  <main id="main-content" class="pay-shell app-content-frame" data-pay-tab data-m15-surface="pay">
    <header class="pay-hero">
      <img
        src="/images/fourth-street-bar-logo.jpg"
        alt=""
        width="720"
        height="720"
        decoding="async"
        class="pay-merchant-logo max-w-full">
      <div class="pay-hero__copy">
        <p class="app-kicker">Pay at 4th Street Bar</p>
        <h1 class="app-page-title">Pay your tab with HBD</h1>
        <p class="pay-hero__lede">
          Use the current V4V/POS Hive invoice. Hive-Bar validates one exact HBD transfer to
          <% payment.merchants.forEach((merchant, index) => { %><%= index ? ', ' : '' %><strong>@<%= merchant %></strong><% }) %>
          before any transaction can be reviewed in Hive Keychain.
        </p>
        <div class="pay-merchant-meta">
          <span>Merchant <% payment.merchants.forEach((merchant, index) => { %><%= index ? ', ' : '' %>@<%= merchant %><% }) %></span>
          <span aria-hidden="true">·</span>
          <span>Controlled maximum <%= payment.maxHbd %></span>
        </div>
      </div>
    </header>

    <section class="pay-safety" aria-labelledby="pay-safety-heading">
      <h2 id="pay-safety-heading" class="sr-only">Payment safety model</h2>
      <div class="pay-safety__item">
        <strong>Exact transfer</strong>
        <span>Payer, merchant, amount, memo, operation, and fingerprint are shown before signing.</span>
      </div>
      <div class="pay-safety__item">
        <strong>Active in Keychain</strong>
        <span>The transaction request remains browser-local and opens only after exact review.</span>
      </div>
      <div class="pay-safety__item">
        <strong>Paid means irreversible</strong>
        <span>Hive-Bar marks Paid only after two independent Hive nodes report the same exact transfer as irreversible.</span>
      </div>
    </section>

    <p class="pay-no-retry">
      <strong>Do not pay again after ambiguity.</strong> Keychain acceptance means broadcast pending, not Paid. Recheck the durable receipt after a timeout or incomplete confirmation.
    </p>

    <% if (!hiveSession) { %>
      <section class="pay-state-panel" aria-labelledby="pay-sign-in-heading">
        <p class="app-kicker">Payment unavailable</p>
        <h2 id="pay-sign-in-heading">Verified sign-in required</h2>
        <p>Use the Hive Keychain sign-in control in <strong>You</strong>. Sign-in uses Posting authority for identity verification and does not create a transaction.</p>
      </section>
    <% } else if (!payment.enabled) { %>
      <section class="pay-state-panel" aria-labelledby="pay-disabled-heading">
        <p class="app-kicker">Safe state</p>
        <h2 id="pay-disabled-heading">Pay Tab is safely disabled</h2>
        <p>A separately authorized controlled payment window is required before Hive-Bar can prepare an Active-authority transfer.</p>
      </section>
      <%- include('partials/receipt', { receiptClass: 'pay-receipt--standalone' }) %>
    <% } else { %>
      <div class="pay-workspace grid grid-cols-1 gap-6 lg:grid-cols-2">
        <section class="pay-invoice-panel" aria-labelledby="invoice-heading">
          <div class="pay-step-heading">
            <span aria-hidden="true">1</span>
            <div>
              <p class="app-kicker">Current invoice</p>
              <h2 id="invoice-heading">Scan or paste the Hive payment URI</h2>
            </div>
          </div>
          <p class="pay-panel-copy">Camera and imported-image data stay in this browser. Only the bounded URI is sent to Hive-Bar for strict validation. In V4V, use a Hive HBD payment QR—not a Lightning or LNURL invoice.</p>

          <div class="pay-capture-actions">
            <button type="button" class="button-secondary" data-pay-camera-start>Start camera</button>
            <button type="button" class="button-secondary" data-pay-camera-stop hidden>Stop camera</button>
            <label class="button-secondary cursor-pointer" for="pay-invoice-image">Import QR image</label>
            <input id="pay-invoice-image" class="sr-only" type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-pay-image>
          </div>
          <video class="pay-camera hidden aspect-video w-full" playsinline muted aria-hidden="true" data-pay-video></video>

          <form class="pay-invoice-form" data-pay-form>
            <div>
              <label for="pay-invoice-uri">Hive payment URI</label>
              <textarea
                id="pay-invoice-uri"
                name="uri"
                rows="5"
                required
                maxlength="16384"
                spellcheck="false"
                autocapitalize="none"
                autocomplete="off"
                placeholder="hive://sign/transfer/..."
                data-pay-uri
              ></textarea>
            </div>
            <button type="submit" class="button-primary w-full">Validate and review exact transfer</button>
          </form>
          <p class="pay-signing-boundary"><strong>Signing boundary:</strong> Hive Keychain requests Active authority only after the exact transfer has been validated and reviewed.</p>
          <p class="pay-status" role="status" aria-live="polite" data-pay-status>Ready for a current V4V/POS invoice.</p>
        </section>

        <%- include('partials/receipt', { receiptClass: '' }) %>
      </div>
    <% } %>
  </main>
  <%- include('../../common/footer') %>
  <% if (hiveSession) { %>
    <% if (payment.enabled) { %><script src="/vendor/zxing/zxing-browser.min.js" defer></script><% } %>
    <script src="/js/pay-tab.js" defer></script>
  <% } %>
</body>
</html>
