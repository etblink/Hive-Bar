<section class="social-home-feed" aria-labelledby="latest-updates-heading">
  <div class="app-content-frame">
    <div class="app-social-column">
      <div class="social-section-heading">
        <div>
          <p class="app-kicker">From 4th Street Bar</p>
          <h2 id="latest-updates-heading" class="app-section-title">Latest from the bar</h2>
        </div>
        <a href="/community" class="button-secondary">See the community</a>
      </div>

      <% if (officialUpdates.status === 'ready') { %>
        <ul class="social-feed" aria-label="Latest official updates">
          <% officialUpdates.items.forEach((post) => { %>
            <li class="social-feed-item">
              <article class="social-update">
                <div class="social-update__identity">
                  <span class="social-update__mark" aria-hidden="true">
                    <img
                      src="/images/fourth-street-bar-logo.jpg"
                      alt=""
                      width="720"
                      height="720"
                      class="max-w-full">
                  </span>
                  <span>4th Street Bar · Official update</span>
                </div>
                <h3>
                  <a href="/post/<%= post.author %>/<%= post.permlink %>"><%= post.title %></a>
                </h3>
                <p class="social-update__excerpt"><%= post.excerpt || 'Read the full update in the community.' %></p>
                <footer class="social-update__footer">
                  <a href="/post/<%= post.author %>/<%= post.permlink %>">Read update<span class="sr-only">: <%= post.title %></span></a>
                </footer>
              </article>
            </li>
          <% }) %>
        </ul>
      <% } else if (officialUpdates.status === 'unavailable') { %>
        <section class="state-card" role="status">
          <p class="eyebrow">Latest updates</p>
          <h2>Updates are temporarily unavailable</h2>
          <p>We couldn’t load the bar’s latest updates. You can still browse the community.</p>
        </section>
      <% } else { %>
        <section class="state-card">
          <p class="eyebrow">Latest updates</p>
          <h2>Nothing from the bar yet</h2>
          <p>Official posts will appear here as they’re published.</p>
        </section>
      <% } %>
    </div>
  </div>
</section>
