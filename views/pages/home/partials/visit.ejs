<section id="visit" class="bg-gray-900 py-14 sm:py-20" aria-labelledby="visit-heading">
  <div class="container mx-auto px-4 sm:px-6">
    <p class="eyebrow">Visit the bar</p>
    <h2 id="visit-heading" class="mt-2 text-3xl font-bold sm:text-4xl">The essentials</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <section class="fact-card">
        <h3>Address</h3>
        <p><%= business.address %></p>
        <a href="<%= business.mapUrl %>" target="_blank" rel="noopener noreferrer">Open directions</a>
      </section>
      <section class="fact-card">
        <h3>Hours</h3>
        <p><%= business.hours %></p>
        <span>Check the official site for holiday changes.</span>
      </section>
      <section class="fact-card">
        <h3>Phone</h3>
        <p><%= business.phone %></p>
        <a href="<%= business.websiteUrl %>" target="_blank" rel="noopener noreferrer">Official bar website</a>
      </section>
    </div>
  </div>
</section>
