<section class="bg-gray-950 py-14 sm:py-20" aria-labelledby="photos-heading">
  <div class="app-content-frame">
    <p class="app-kicker">Inside 4th Street Bar</p>
    <h2 id="photos-heading" class="app-section-title mt-2">A little of the place</h2>
    <p class="mt-4 max-w-2xl text-gray-300">
      Pool, a welcome from behind the bar, and the East 4th Street entrance.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <figure class="venue-photo-card">
        <img
          src="/images/fourth-street-bar-pool-table.jpg"
          alt="Pool table and crossed cues inside 4th Street Bar"
          width="720"
          height="960"
          loading="lazy"
          decoding="async"
          class="venue-photo venue-photo--portrait w-full">
        <figcaption class="venue-photo-caption">Pool at the heart of the bar</figcaption>
      </figure>

      <figure class="venue-photo-card">
        <img
          src="/images/fourth-street-bar-bartender.jpg"
          alt="A smiling bartender behind the bar holding a 4th Street Bar mug"
          width="768"
          height="960"
          loading="lazy"
          decoding="async"
          class="venue-photo venue-photo--portrait venue-photo--top w-full">
        <figcaption class="venue-photo-caption">A welcome from behind the bar</figcaption>
      </figure>

      <figure class="venue-photo-card">
        <img
          src="/images/fourth-street-bar-exterior.jpg"
          alt="The 4th Street Bar entrance and sign on East 4th Street in Reno"
          width="720"
          height="960"
          loading="lazy"
          decoding="async"
          class="venue-photo venue-photo--portrait w-full">
        <figcaption class="venue-photo-caption">1114 East 4th Street</figcaption>
      </figure>
    </div>
  </div>
</section>
