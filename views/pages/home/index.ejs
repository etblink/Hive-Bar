<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../common/head') %>
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/ux-1f-home.css') : '/css/ux-1f-home.css' %>">
</head>
<body class="flex min-h-screen flex-col">
  <%- include('../../common/header') %>
  <main
    id="main-content"
    class="social-home home-page"
    data-m15-surface="home"
    data-m18-3-surface="home"
    data-ux-1f-surface="home">
    <%- include('partials/hero') %>
    <%- include('partials/latest-updates', { officialUpdates }) %>
    <section class="home-pathways" aria-labelledby="home-pathways-heading">
      <div class="app-content-frame home-section">
        <header class="home-section-heading home-pathways__heading">
          <div>
            <p class="home-kicker">In Reno and online</p>
            <h2 id="home-pathways-heading">Two ways to pull up a stool</h2>
          </div>
          <p>Come through the front door or join the conversation from wherever you are.</p>
        </header>
        <div class="home-pathways__grid">
          <%- include('partials/visit') %>
          <%- include('partials/community') %>
        </div>
      </div>
    </section>
    <%- include('partials/photos') %>
  </main>
  <%- include('../../common/footer') %>
</body>
</html>
