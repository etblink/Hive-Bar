<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../common/head') %>
</head>
<body class="flex min-h-screen flex-col">
  <%- include('../../common/header') %>
  <main id="main-content" class="app-content-frame flex-1 py-10 sm:py-14" data-c2-f-surface="onboarding-management">
    <header class="mx-auto max-w-5xl">
      <p class="app-kicker">Onboarding operations</p>
      <h1 class="app-page-title mt-2">Durable onboarding requests</h1>
      <p class="mt-4 max-w-3xl text-gray-300">Read-only operational view for @<%= onboarding.creator %>. Use an individual request page for any permitted action.</p>
    </header>

    <section class="mx-auto mt-8 max-w-5xl rounded-2xl border border-gray-700 bg-gray-900 p-5 sm:p-7" aria-labelledby="onboarding-lane-heading">
      <h2 id="onboarding-lane-heading" class="text-xl font-bold">Creator transaction lane</h2>
      <% if (lane) { %>
        <p class="mt-3 text-gray-300">Held by <a class="font-bold text-bar-gold underline" href="/onboarding/staff/<%= lane.id %>">@<%= lane.username %></a> in <strong><%= lane.status %></strong>. Do not start a second Keychain broadcast.</p>
      <% } else { %>
        <p class="mt-3 text-gray-300">No prepared/signing/observing onboarding request currently holds the creator lane.</p>
      <% } %>
    </section>

    <section class="mx-auto mt-6 max-w-5xl" aria-labelledby="onboarding-recent-heading">
      <h2 id="onboarding-recent-heading" class="text-xl font-bold">Recent requests</h2>
      <% if (requests.length === 0) { %>
        <p class="mt-3 rounded-2xl border border-gray-700 bg-gray-900 p-5 text-gray-300">No durable onboarding requests are recorded.</p>
      <% } else { %>
        <div class="mt-4 grid gap-4">
          <% for (const request of requests) { %>
            <article class="rounded-2xl border border-gray-700 bg-gray-900 p-5">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-bold"><a class="text-bar-gold underline" href="/onboarding/staff/<%= request.id %>">@<%= request.username %></a></h3>
                  <p class="mt-1 text-sm text-gray-400">Created <%= new Date(request.createdAt).toISOString() %></p>
                </div>
                <span class="rounded-full border border-gray-600 px-3 py-1 text-xs font-bold uppercase tracking-wide"><%= request.status %></span>
              </div>
              <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
                <div><dt class="text-gray-500">Revision</dt><dd class="mt-1"><%= request.revision %></dd></div>
                <div><dt class="text-gray-500">Starter delegation</dt><dd class="mt-1"><%= request.starterHp %></dd></div>
                <div><dt class="text-gray-500">Cash confirmed</dt><dd class="mt-1"><%= request.cashConfirmedAt ? 'Yes' : 'No' %></dd></div>
              </dl>
            </article>
          <% } %>
        </div>
      <% } %>
    </section>
  </main>
  <%- include('../../common/footer') %>
</body>
</html>
