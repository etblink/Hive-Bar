<section class="profile-hero" aria-labelledby="profile-heading">
  <div class="profile-hero__top">
    <img
      src="<%= userProfile.profileImage %>"
      alt=""
      class="profile-hero__avatar"
      width="96"
      height="96">
    <div class="profile-hero__identity">
      <p class="app-kicker">Hive profile</p>
      <h1 id="profile-heading"><%= userProfile.displayName %></h1>
      <p class="profile-hero__handle">@<%= userProfile.name %></p>
    </div>
  </div>

  <% if (userProfile.about) { %>
    <p class="profile-hero__about break-words"><%= userProfile.about %></p>
  <% } %>

  <div class="profile-hero__stats">
    <a href="/profile/<%= userProfile.name %>/followers"><strong><%= userProfile.followerCount.toLocaleString() %></strong> followers</a>
    <a href="/profile/<%= userProfile.name %>/following"><strong><%= userProfile.followingCount.toLocaleString() %></strong> following</a>
    <span><strong><%= userProfile.postCount.toLocaleString() %></strong> posts</span>
    <span>Reputation <strong><%= userProfile.reputation %></strong></span>
  </div>

  <div class="profile-hero__action">
    <% if (hiveSession && hiveSession.account !== userProfile.name && canWriteAction(followState ? 'unfollow' : 'follow') && followState !== null) { %>
      <form data-social-action="<%= followState ? 'unfollow' : 'follow' %>">
        <input type="hidden" name="following" value="<%= userProfile.name %>">
        <button type="submit" class="button-primary"><%= followState ? 'Unfollow' : 'Follow' %> @<%= userProfile.name %></button>
        <p class="mt-2 text-xs text-gray-300" aria-live="polite" data-social-status>
          <%= followState ? 'You’re following this account.' : 'You’re not following this account.' %>
        </p>
      </form>
    <% } else if (hiveSession && hiveSession.account === userProfile.name) { %>
      <p class="rounded-lg border border-gray-700 bg-black/40 p-3 text-sm text-gray-400">This is your profile.</p>
    <% } else if (!hiveSession) { %>
      <p class="rounded-lg border border-gray-700 bg-black/40 p-3 text-sm text-gray-400">
        Sign in with Hive Keychain to follow @<%= userProfile.name %>.
      </p>
    <% } else { %>
      <p class="rounded-lg border border-gray-700 bg-black/40 p-3 text-sm text-gray-400">
        Following isn’t available in this release yet.
      </p>
    <% } %>
  </div>
</section>
