<section class="rounded-2xl border border-gray-700 bg-gray-900 p-6 text-center" aria-labelledby="profile-name-heading">
  <img src="<%= userProfile.profileImage %>" alt="" class="mx-auto mb-4 h-24 w-24 rounded-full bg-gray-800" width="96" height="96">
  <h2 id="profile-name-heading" class="text-2xl font-bold"><%= userProfile.displayName %></h2>
  <p class="mt-1 text-gray-400">@<%= userProfile.name %></p>
  <% if (userProfile.about) { %>
    <p class="mt-5 break-words text-sm leading-6 text-gray-200"><%= userProfile.about %></p>
  <% } %>
  <dl class="mt-6 grid grid-cols-2 gap-3">
    <div class="stat-tile">
      <dt>Followers</dt>
      <dd><a class="underline hover:text-bar-gold" href="/profile/<%= userProfile.name %>/followers"><%= userProfile.followerCount.toLocaleString() %></a></dd>
    </div>
    <div class="stat-tile">
      <dt>Following</dt>
      <dd><a class="underline hover:text-bar-gold" href="/profile/<%= userProfile.name %>/following"><%= userProfile.followingCount.toLocaleString() %></a></dd>
    </div>
    <div class="stat-tile">
      <dt>Posts</dt>
      <dd><%= userProfile.postCount.toLocaleString() %></dd>
    </div>
    <div class="stat-tile">
      <dt>Reputation</dt>
      <dd><%= userProfile.reputation %></dd>
    </div>
  </dl>
  <% if (hiveSession && hiveSession.account !== userProfile.name && writesEnabled && followState !== null) { %>
    <form class="mt-5" data-social-action="<%= followState ? 'unfollow' : 'follow' %>">
      <input type="hidden" name="following" value="<%= userProfile.name %>">
      <button type="submit" class="button-primary w-full"><%= followState ? 'Unfollow' : 'Follow' %> @<%= userProfile.name %></button>
      <p class="mt-2 text-xs text-gray-300" aria-live="polite" data-social-status>
        Current on-chain state: <%= followState ? 'following' : 'not following' %>.
      </p>
    </form>
  <% } else if (hiveSession && !writesEnabled) { %>
    <p class="mt-5 rounded-lg border border-gray-700 bg-black/40 p-3 text-sm text-gray-400">
      Follow signing is disabled until an individually authorized controlled-write run.
    </p>
  <% } else if (!hiveSession) { %>
    <p class="mt-5 rounded-lg border border-gray-700 bg-black/40 p-3 text-sm text-gray-400">
      Sign in with Hive Keychain to follow this account.
    </p>
  <% } %>
</section>
