<section class="rounded-lg bg-gray-800 p-6 text-center">
  <img src="<%= userProfile.profile.profileImage %>" alt="<%= userProfile.name %> profile picture" class="mx-auto mb-4 h-24 w-24 rounded-full" width="96" height="96">
  <h2 class="mb-2 text-2xl font-bold"><%= userProfile.profile.name %></h2>
  <p class="mb-4 text-gray-400">@<%= userProfile.name %></p>
  <% if (userProfile.profile.about) { %>
    <p class="mb-6 text-sm text-gray-200"><%= userProfile.profile.about %></p>
  <% } %>
  <dl class="mb-6 flex justify-center gap-10">
    <div>
      <dt class="text-sm text-gray-400">Followers</dt>
      <dd class="text-xl font-bold"><%= userProfile.follower_count.toLocaleString() %></dd>
    </div>
    <div>
      <dt class="text-sm text-gray-400">Following</dt>
      <dd class="text-xl font-bold"><%= userProfile.following_count.toLocaleString() %></dd>
    </div>
  </dl>
  <p class="rounded border border-gray-600 bg-gray-900 p-3 text-sm text-gray-300">
    Verified owner controls and follow actions return with the secure Keychain session milestone.
  </p>
</section>
