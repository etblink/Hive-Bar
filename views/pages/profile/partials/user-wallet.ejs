<section class="wallet-social c2c-wallet c2c1-wallet" aria-labelledby="wallet-heading" data-m15-surface="wallet" data-c2c-surface="wallet" data-c2c1-surface="wallet">
  <header class="wallet-social__header c2c1-wallet__header">
    <p class="app-kicker">Bar wallet</p>
    <div class="c2c1-wallet__title-row">
      <h2 id="wallet-heading" class="app-section-title">@<%= userProfile.name %> wallet</h2>
      <span class="wallet-social__badge">Public on Hive</span>
    </div>
  </header>

  <section class="c2c1-status-hero" aria-labelledby="milestone-heading" data-c2c1-region="status">
    <div class="c2c1-status-hero__identity">
      <div class="c2c1-status-badge" aria-hidden="true">
        <span class="c2c1-status-badge__label">Bar level</span>
        <span class="c2c1-status-badge__icon"><%= wallet.milestone.icon %></span>
      </div>
      <div class="c2c1-status-hero__copy">
        <p class="app-kicker">Your bar level</p>
        <h3 id="milestone-heading"><%= wallet.milestone.name %></h3>
        <div class="c2c1-status-hero__basis">
          <strong><%= formatNumber(wallet.hivePower) %> HP</strong>
          <span class="c2c-wallet__protocol">Hive Power</span>
        </div>
      </div>
    </div>
    <div class="c2c1-status-hero__progress">
      <div class="c2c1-status-hero__progress-label">
        <span><%= wallet.milestone.hasNextLevel ? 'Progress to the next bar level' : 'Highest listed bar level reached' %></span>
        <% if (wallet.milestone.hasNextLevel) { %>
          <span><%= wallet.milestone.max.toLocaleString() %> HP</span>
        <% } %>
      </div>
      <meter class="wallet-meter c2c1-status-meter" min="0" max="100" value="<%= wallet.milestone.progressPercent %>">
        <%= formatNumber(wallet.milestone.progressPercent, 1) %>%
      </meter>
    </div>
  </section>

  <% const activityState = wallet.resourceCreditsPercent >= 70
    ? 'Plenty of room'
    : wallet.resourceCreditsPercent >= 35
      ? 'Room to participate'
      : wallet.resourceCreditsPercent >= 15
        ? 'Running low'
        : 'Refilling';
  const activityMarksFilled = Math.max(0, Math.min(5, Math.ceil(wallet.resourceCreditsPercent / 20))); %>

  <section class="c2c1-participation" aria-labelledby="participation-heading" data-c2c1-region="participation">
    <div class="c2c1-section-heading">
      <div>
        <p class="app-kicker">Participation</p>
        <h3 id="participation-heading">Ready to take part</h3>
      </div>
    </div>

    <div class="c2c1-participation-stage">
      <figure class="c2c1-pour" aria-labelledby="voting-power-heading">
        <div class="c2c1-pour__visual">
          <div class="beer-pitcher c2c1-pitcher" role="img" aria-label="Voting strength: <%= formatNumber(wallet.votingPowerPercent, 2) %> percent">
            <div class="beer-foam" aria-hidden="true"></div>
            <div class="beer-segments" aria-hidden="true">
              <% for (let segment = 10; segment >= 1; segment -= 1) { %>
                <span class="beer-segment <%= segment <= wallet.beerSegmentsFilled ? 'beer-segment--filled' : '' %>"></span>
              <% } %>
            </div>
          </div>
        </div>
        <figcaption class="c2c1-pour__copy">
          <p class="app-kicker">Your pitcher</p>
          <h4 id="voting-power-heading">Voting strength</h4>
          <strong><%= formatNumber(wallet.votingPowerPercent, 2) %>%</strong>
          <span class="c2c-wallet__protocol">Voting power</span>
        </figcaption>
      </figure>

      <section class="c2c1-capacity" aria-labelledby="resources-heading">
        <div class="c2c1-capacity__headline">
          <div>
            <p class="app-kicker">Activity</p>
            <h4 id="resources-heading">Activity capacity</h4>
          </div>
          <strong class="c2c1-capacity__state"><%= activityState %></strong>
        </div>
        <div class="c2c1-capacity__marks" aria-hidden="true">
          <% for (let mark = 1; mark <= 5; mark += 1) { %>
            <span class="c2c1-capacity__mark <%= mark <= activityMarksFilled ? 'c2c1-capacity__mark--filled' : '' %>"></span>
          <% } %>
        </div>
        <details class="c2c1-capacity__protocol-detail">
          <summary><%= formatNumber(wallet.resourceCreditsPercent, 2) %>% RC</summary>
          <span class="c2c-wallet__protocol">Resource credits (RC)</span>
        </details>
      </section>
    </div>
  </section>

  <section class="c2c1-balances" aria-labelledby="available-heading" data-c2c1-region="balances">
    <div class="c2c1-section-heading">
      <div>
        <p class="app-kicker">Your balances</p>
        <h3 id="available-heading">Available now</h3>
      </div>
    </div>
    <dl class="c2c1-balances__grid grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div class="c2c1-balance">
        <dt>Available HBD <span class="c2c-wallet__protocol">Liquid HBD</span></dt>
        <dd><%= formatNumber(wallet.liquidHbd) %> <span>HBD</span></dd>
      </div>
      <div class="c2c1-balance">
        <dt>Available HIVE <span class="c2c-wallet__protocol">Liquid HIVE</span></dt>
        <dd><%= formatNumber(wallet.liquidHive) %> <span>HIVE</span></dd>
      </div>
    </dl>
  </section>

  <section class="c2c1-rewards" aria-labelledby="rewards-heading" data-c2c1-region="rewards">
    <div class="c2c1-rewards__heading">
      <div>
        <p class="app-kicker">Rewards</p>
        <h3 id="rewards-heading">Ready to claim</h3>
        <span class="c2c-wallet__protocol">Claimable rewards</span>
      </div>
      <% if (!wallet.hasClaimableRewards) { %>
        <strong class="c2c1-rewards__state">Nothing waiting</strong>
      <% } %>
    </div>
    <% if (wallet.hasClaimableRewards) { %>
      <dl class="wallet-rewards c2c1-rewards__values">
        <div><dt>HIVE</dt><dd><%= formatNumber(wallet.rewards.hive) %></dd></div>
        <div><dt>HBD</dt><dd><%= formatNumber(wallet.rewards.hbd) %></dd></div>
        <div><dt>Hive Power</dt><dd><%= formatNumber(wallet.rewards.hivePower) %></dd></div>
      </dl>
      <% if (canManageProfile && (writesEnabled || canWriteAction('claim-rewards'))) { %>
        <form class="wallet-reward-action" data-m4-action="claim-rewards">
          <button type="submit" class="button-primary">Review reward claim</button>
          <p aria-live="polite" data-m4-status>
            Hive-Bar checks your current rewards again before Keychain asks for approval.
          </p>
        </form>
      <% } else if (canManageProfile) { %>
        <p class="wallet-module__note">Claiming rewards isn’t available here yet.</p>
      <% } %>
    <% } %>
  </section>

  <details class="c2c1-wallet-disclosure">
    <summary>How this wallet works</summary>
    <p>This page only reads public Hive data. Hive-Bar cannot move funds or access private keys from here. Any available account action is reviewed in Keychain before it happens.</p>
    <a class="c2c-wallet__learn" href="/faq#wallet">What do these Hive terms mean?</a>
  </details>

  <p class="wallet-snapshot-time c2c1-wallet__snapshot">
    Updated at <time datetime="<%= wallet.displayedAt %>"><%= formatHiveDate(wallet.displayedAt) %></time>.
  </p>
</section>
