<section class="rounded-2xl border border-gray-700 bg-gray-900 p-5 sm:p-7" aria-labelledby="connections-heading">
  <p class="eyebrow">Connections</p>
  <h2 id="connections-heading" class="mt-2 text-2xl font-bold">
    @<%= userProfile.name %> <%= connectionKind %>
  </h2>
  <div class="mt-5 space-y-2">
    <%- include('follow-list', { users: connectionPage.items, emptyMessage: connectionEmptyMessage }) %>
  </div>
  <% if (connectionPage.nextCursor) { %>
    <nav class="mt-6 flex justify-center" aria-label="<%= connectionKind %> pagination">
      <a
        href="/profile/<%= userProfile.name %>/<%= connectionKind %>?after=<%= connectionPage.nextCursor %>"
        hx-get="/profile/<%= userProfile.name %>/<%= connectionKind %>?after=<%= connectionPage.nextCursor %>"
        hx-target="#profile-content"
        class="button-secondary">
        Next page
      </a>
    </nav>
  <% } %>
</section>
