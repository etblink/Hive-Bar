<div class="profile-shell" data-m15-surface="profile">
  <div class="app-content-frame">
    <div class="app-social-column">
      <%- include('profile-info-card') %>

      <nav class="profile-tabs social-tabs" aria-label="Profile content">
        <a
          href="/profile/<%= userProfile.name %>"
          hx-get="/profile/<%= userProfile.name %>/blogs"
          hx-target="#profile-content"
          class="content-tab <%= activeView === 'posts' ? 'content-tab--active' : '' %>"
          <% if (activeView === 'posts') { %>aria-current="page"<% } %>>
          Posts
        </a>
        <a
          href="/profile/<%= userProfile.name %>/wallet"
          hx-get="/profile/<%= userProfile.name %>/wallet"
          hx-target="#profile-content"
          class="content-tab <%= activeView === 'wallet' ? 'content-tab--active' : '' %>"
          <% if (activeView === 'wallet') { %>aria-current="page"<% } %>>
          Wallet
        </a>
        <a
          href="/profile/<%= userProfile.name %>/wall-posts"
          hx-get="/profile/<%= userProfile.name %>/wall-posts"
          hx-target="#profile-content"
          class="content-tab <%= activeView === 'wall' ? 'content-tab--active' : '' %>"
          <% if (activeView === 'wall') { %>aria-current="page"<% } %>>
          Wall
        </a>
        <% if (canManageProfile) { %>
          <a
            href="/profile/<%= userProfile.name %>/inbox"
            hx-get="/profile/<%= userProfile.name %>/inbox"
            hx-target="#profile-content"
            class="content-tab <%= activeView === 'inbox' ? 'content-tab--active' : '' %>"
            <% if (activeView === 'inbox') { %>aria-current="page"<% } %>>
            Inbox
          </a>
          <a
            href="/profile/<%= userProfile.name %>/settings"
            hx-get="/profile/<%= userProfile.name %>/settings"
            hx-target="#profile-content"
            class="content-tab <%= activeView === 'settings' ? 'content-tab--active' : '' %>"
            <% if (activeView === 'settings') { %>aria-current="page"<% } %>>
            Settings
          </a>
        <% } %>
      </nav>

      <div id="profile-content" class="profile-content-panel" aria-live="polite">
        <% if (activeView === 'wallet') { %>
          <%- include('user-wallet', { userProfile, wallet, canManageProfile }) %>
        <% } else if (activeView === 'wall') { %>
          <%- include('wall-posts', { userProfile, wallPage, profileSettings, canManageProfile }) %>
        <% } else if (activeView === 'followers' || activeView === 'following') { %>
          <%- include('connections', { userProfile, connectionPage, connectionKind, connectionEmptyMessage }) %>
        <% } else if (activeView === 'inbox') { %>
          <%- include('inbox', { userProfile, inboxPage, profileSettings }) %>
        <% } else if (activeView === 'settings') { %>
          <%- include('settings', { userProfile, profileSettings }) %>
        <% } else { %>
          <%- include('user-blog-posts', { userProfile, postsPage }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>
