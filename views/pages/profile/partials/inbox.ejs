<section class="rounded-2xl border border-gray-700 bg-gray-900 p-5 sm:p-7" aria-labelledby="inbox-heading">
  <p class="eyebrow">Private messages</p>
  <h2 id="inbox-heading" class="mt-2 text-2xl font-bold">Your encrypted inbox</h2>
  <p class="mt-3 text-sm leading-6 text-gray-300">Messages are stored on Hive as encrypted text. When you choose Decrypt, Hive Keychain uses your Memo key locally in this browser; the decrypted message is not sent back to Hive-Bar.</p>

  <div class="mt-6 space-y-4">
    <% if (inboxPage.items.length > 0) { %>
      <% inboxPage.items.forEach((item) => { %>
        <article class="wallet-panel" data-inbox-entry>
          <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
            <a class="font-bold text-bar-gold hover:underline" href="/profile/<%= item.sender %>">@<%= item.sender %></a>
            <span><%= item.amount %></span>
          </div>
          <button type="button" class="button-primary mt-4" data-inbox-ciphertext="<%= item.ciphertext %>">Decrypt with Keychain</button>
          <p class="mt-4 whitespace-pre-wrap break-words rounded-lg border border-gray-600 bg-black p-4 text-gray-100" data-inbox-plaintext hidden></p>
          <p class="mt-3 text-xs text-gray-300" aria-live="polite" data-m4-status></p>
          <p class="mt-3 text-xs text-gray-500"><time datetime="<%= item.timestamp %>"><%= formatHiveDate(item.timestamp) %></time></p>
          <details class="mt-2 text-xs text-gray-500">
            <summary class="cursor-pointer">Transaction details</summary>
            <p class="mt-2 break-all">Block <%= item.blockNumber || 'pending' %> · transaction <code><%= item.transactionId %></code></p>
          </details>
        </article>
      <% }); %>
    <% } else { %>
      <p class="rounded-lg border border-gray-700 bg-black/40 p-4 text-gray-300">No encrypted messages yet.</p>
    <% } %>
  </div>
  <% if (inboxPage.nextCursor) { %>
    <a class="button-secondary mt-6 inline-flex" href="/profile/<%= userProfile.name %>/inbox?before=<%= inboxPage.nextCursor %>" hx-get="/profile/<%= userProfile.name %>/inbox?before=<%= inboxPage.nextCursor %>" hx-target="#profile-content">Older messages</a>
  <% } %>
</section>
