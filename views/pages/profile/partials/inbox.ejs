<section class="message-surface message-surface--inbox" aria-labelledby="inbox-heading">
  <header class="message-surface__intro">
    <p class="eyebrow">Private messages</p>
    <h2 id="inbox-heading" class="mt-2 text-2xl font-bold">Your encrypted inbox</h2>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-gray-300">Messages are stored on Hive as encrypted text. Hive Keychain uses your Memo key in this browser to decrypt the message locally; the decrypted message is not sent back to Hive-Bar.</p>
  </header>

  <% if (inboxPage.items.length > 0) { %>
    <div class="message-list message-list--inbox" data-message-list="inbox">
      <% inboxPage.items.forEach((item) => { %>
        <% const senderProfile = messageProfiles[item.sender] || {}; %>
        <% const senderDisplayName = senderProfile.displayName || item.sender; %>
        <article class="message-entry message-entry--inbox" data-message-entry data-message-kind="inbox" data-inbox-entry>
          <header class="message-entry__identity">
            <div class="social-author">
              <% if (senderProfile.profileImage) { %>
                <img class="message-entry__avatar" src="<%= senderProfile.profileImage %>" alt="" width="40" height="40" loading="lazy">
              <% } else { %>
                <span class="message-entry__avatar message-entry__avatar--fallback" aria-hidden="true"><%= item.sender.slice(0, 1).toUpperCase() %></span>
              <% } %>
              <div class="social-author__text">
                <a class="social-author__name" href="/profile/<%= item.sender %>"><%= senderDisplayName %></a>
                <div class="social-author__meta">
                  <span>@<%= item.sender %></span>
                  <time datetime="<%= item.timestamp %>"><%= formatHiveDate(item.timestamp) %></time>
                </div>
              </div>
            </div>
          </header>

          <div class="message-entry__private-content">
            <button type="button" class="button-secondary message-entry__decrypt" data-inbox-ciphertext="<%= item.ciphertext %>">Decrypt with Keychain</button>
            <p class="message-entry__body message-entry__body--private" data-inbox-plaintext hidden></p>
            <p class="message-entry__status" aria-live="polite" data-m4-status></p>
          </div>

          <footer class="message-entry__activity">
            <span class="message-entry__amount"><span class="sr-only">Payment: </span><%= item.amount %></span>
            <details class="message-entry__details">
              <summary>Transaction details</summary>
              <p>Block <%= item.blockNumber || 'pending' %> · transaction <code><%= item.transactionId %></code></p>
            </details>
          </footer>
        </article>
      <% }); %>
    </div>
  <% } else { %>
    <p class="message-surface__empty">No encrypted messages yet.</p>
  <% } %>

  <% if (inboxPage.nextCursor) { %>
    <a class="button-secondary mt-6 inline-flex" href="/profile/<%= userProfile.name %>/inbox?before=<%= inboxPage.nextCursor %>" hx-get="/profile/<%= userProfile.name %>/inbox?before=<%= inboxPage.nextCursor %>" hx-target="#profile-content">Older messages</a>
  <% } %>
</section>
