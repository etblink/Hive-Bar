<section class="rounded-2xl border border-gray-700 bg-gray-900 p-5 sm:p-7" aria-labelledby="wall-heading">
  <p class="eyebrow">Paid public messages</p>
  <h2 id="wall-heading" class="mt-2 text-2xl font-bold">@<%= userProfile.name %> wall</h2>
  <p class="mt-3 text-sm leading-6 text-gray-300">
    Minimum fee: <strong class="text-white"><%= profileSettings.wallFee %></strong>. Qualifying messages and transfer facts are public and permanent on Hive. Unmarked transfers, encrypted memos, amounts below the fee, and excluded senders do not appear here.
  </p>

  <% const betaMessagingEnabled = Boolean(config?.hive?.betaSelfSigningEnabled); %>
  <% if (hiveSession && (writesEnabled || betaMessagingEnabled)) { %>
    <div class="mt-6 grid gap-5 xl:grid-cols-2">
      <form class="wallet-panel" data-m4-action="wall">
        <h3 class="text-lg font-bold text-bar-gold">Leave a public wall message</h3>
        <input type="hidden" name="recipient" value="<%= userProfile.name %>">
        <input type="hidden" name="expectedFee" value="<%= profileSettings.wallFee %>">
        <input type="hidden" name="amount" value="<%= profileSettings.wallFee %>">
        <label for="wall-message" class="mt-4 block text-sm font-bold">Public memo text</label>
        <textarea id="wall-message" name="message" required rows="4" data-max-bytes="2000" class="mt-2 w-full rounded-lg border border-gray-600 bg-black p-3 text-white"></textarea>
        <p class="mt-1 text-xs text-gray-400" data-byte-counter>0 / 2,000 UTF-8 bytes</p>
        <button type="submit" class="button-primary mt-4">Review <%= profileSettings.wallFee %> transfer</button>
        <p class="mt-2 text-xs text-gray-300" aria-live="polite" data-m4-status>Recipient, current fee, public memo, and exact Active operation will be reviewed before signing.</p>
      </form>

      <form class="wallet-panel" data-m4-action="inbox">
        <h3 class="text-lg font-bold text-bar-gold">Send an encrypted inbox message</h3>
        <input type="hidden" name="recipient" value="<%= userProfile.name %>">
        <input type="hidden" name="expectedFee" value="<%= profileSettings.wallFee %>">
        <input type="hidden" name="amount" value="<%= profileSettings.wallFee %>">
        <label for="inbox-message" class="mt-4 block text-sm font-bold">Private memo content</label>
        <textarea id="inbox-message" name="message" required rows="4" data-max-bytes="1500" class="mt-2 w-full rounded-lg border border-gray-600 bg-black p-3 text-white"></textarea>
        <p class="mt-1 text-xs text-gray-400" data-byte-counter>0 / 1,500 UTF-8 bytes</p>
        <p class="mt-3 text-xs leading-5 text-gray-400">Keychain encrypts the content in this browser. Hive-Bar receives only ciphertext. Sender, recipient, amount, timestamp, and transaction remain public and permanent.</p>
        <button type="submit" class="button-primary mt-4">Encrypt and review transfer</button>
        <p class="mt-2 text-xs text-gray-300" aria-live="polite" data-m4-status></p>
      </form>
    </div>
  <% } else if (hiveSession) { %>
    <p class="mt-5 rounded-lg border border-gray-700 bg-black/40 p-3 text-sm text-gray-400">Wall and encrypted-message signing are not enabled in the current write mode.</p>
  <% } else { %>
    <p class="mt-5 rounded-lg border border-gray-700 bg-black/40 p-3 text-sm text-gray-400">Sign in with Hive Keychain to prepare a wall or encrypted inbox transfer.</p>
  <% } %>

  <div class="mt-7 space-y-4">
    <% if (wallPage.items.length > 0) { %>
      <% wallPage.items.forEach((item) => { %>
        <article class="wallet-panel">
          <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
            <a class="font-bold text-bar-gold hover:underline" href="/profile/<%= item.sender %>">@<%= item.sender %></a>
            <span><%= item.amount %></span>
          </div>
          <p class="mt-3 whitespace-pre-wrap break-words text-gray-100"><%= item.message %></p>
          <p class="mt-3 break-all text-xs text-gray-500">
            <time datetime="<%= item.timestamp %>"><%= formatHiveDate(item.timestamp) %></time>
            · block <%= item.blockNumber || 'pending' %>
            · transaction <code><%= item.transactionId %></code>
          </p>
        </article>
      <% }); %>
    <% } else { %>
      <p class="rounded-lg border border-gray-700 bg-black/40 p-4 text-gray-300">No qualifying wall messages appear on this history page.</p>
    <% } %>
  </div>
  <% if (wallPage.nextCursor) { %>
    <a class="button-secondary mt-6 inline-flex" href="/profile/<%= userProfile.name %>/wall-posts?before=<%= wallPage.nextCursor %>" hx-get="/profile/<%= userProfile.name %>/wall-posts?before=<%= wallPage.nextCursor %>" hx-target="#profile-content">Older transfer history</a>
  <% } %>
</section>
