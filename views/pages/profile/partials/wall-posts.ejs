<section data-m18-3-surface="wall" aria-labelledby="wall-heading">
  <header class="py-3">
    <p class="app-kicker">Public wall</p>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-3">
      <div><h2 id="wall-heading" class="app-section-title">@<%= userProfile.name %>’s Wall</h2><p class="mt-3 max-w-2xl text-sm leading-6 text-gray-300">Posting a wall message costs at least <strong class="text-white"><%= profileSettings.wallFee %></strong>. Public wall messages and payment details are permanently visible on Hive.</p></div>
      <p class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-xs font-bold text-gray-300"><strong class="text-white"><%= profileSettings.wallFee %></strong> minimum · Public on Hive</p>
    </div>
  </header>
  <% const messagingEnabled = canWriteAction('wall') && canWriteAction('inbox'); %>
  <% if (hiveSession && messagingEnabled) { %>
    <%- include('../../../common/composer', { composer: {
      id: 'public-wall-composer',
      controller: 'm4',
      action: 'wall',
      headingLevel: 3,
      kicker: 'Write on the wall',
      title: 'Post a public message',
      description: `Write something for @${userProfile.name} and everyone who visits this Wall.`,
      meta: `${profileSettings.wallFee} · Public on Hive`,
      hiddenFields: [
        { name: 'recipient', value: userProfile.name },
        { name: 'expectedFee', value: profileSettings.wallFee },
        { name: 'amount', value: profileSettings.wallFee },
      ],
      fields: [
        { id: 'wall-message', name: 'message', type: 'textarea', label: 'Your message', required: true, maxBytes: 2000, rows: 4, size: 'medium', placeholder: `Write on @${userProfile.name}’s Wall` },
      ],
      submitLabel: `Review message and ${profileSettings.wallFee} payment`,
      disclosure: 'The message, sender, recipient, payment, and transaction are permanently public on Hive. You’ll review the recipient, message, fee, and payment before Keychain asks for approval.',
    } }) %>
    <%- include('../../../common/composer', { composer: {
      id: 'private-wall-composer',
      controller: 'm4',
      action: 'inbox',
      collapsible: true,
      privateDisclosure: true,
      headingLevel: 3,
      kicker: 'Private message',
      title: 'Send a private message',
      description: `Keychain encrypts the message for @${userProfile.name} in this browser.`,
      meta: `${profileSettings.wallFee} · Encrypted text`,
      hiddenFields: [
        { name: 'recipient', value: userProfile.name },
        { name: 'expectedFee', value: profileSettings.wallFee },
        { name: 'amount', value: profileSettings.wallFee },
      ],
      fields: [
        { id: 'inbox-message', name: 'message', type: 'textarea', label: `Private message for @${userProfile.name}`, required: true, maxBytes: 1500, rows: 4, size: 'medium', placeholder: 'Write a private message' },
      ],
      submitLabel: 'Encrypt & review payment',
      submitVariant: 'secondary',
      disclosure: 'Keychain encrypts the message in this browser. The message text stays private, but sender, recipient, HBD amount, time, and transaction remain public on Hive. Encryption happens before review.',
    } }) %>
  <% } else if (hiveSession) { %><p class="mt-5 rounded-lg border border-gray-700 bg-black/40 p-3 text-sm text-gray-400">Wall and private messaging aren’t available here yet.</p><% } else { %><p class="mt-5 border-l-4 border-gray-700 py-2 pl-4 text-sm leading-6 text-gray-300">Sign in with Hive Keychain to write on this wall or send a private message. Reading public wall messages never requires signing in.</p><% } %>
  <section class="mt-8" aria-labelledby="public-wall-messages-heading">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-gray-700 pb-3"><div><p class="app-kicker">On the wall</p><h3 id="public-wall-messages-heading" class="mt-2 text-xl font-bold">Public messages</h3></div><span class="text-xs text-gray-400">Permanent on Hive</span></div>
    <% if (wallPage.items.length > 0) { %><div class="social-feed"><% wallPage.items.forEach((item) => { %><article class="social-feed-item"><div class="social-update"><header class="flex flex-wrap items-center justify-between gap-2 text-sm"><a class="font-bold text-bar-gold hover:underline" href="/profile/<%= item.sender %>">@<%= item.sender %></a><span class="text-gray-400"><%= item.amount %></span></header><p class="mt-3 whitespace-pre-wrap break-words text-gray-100"><%= item.message %></p><footer class="mt-3 flex flex-wrap items-center gap-3 text-xs text-gray-500"><time datetime="<%= item.timestamp %>"><%= formatHiveDate(item.timestamp) %></time><details><summary class="cursor-pointer">Transaction details</summary><p class="mt-2 max-w-full break-all">Block <%= item.blockNumber || 'pending' %> · transaction <code><%= item.transactionId %></code></p></details></footer></div></article><% }); %></div><% } else { %><p class="py-6 text-gray-300">No public wall messages yet.</p><% } %>
  </section>
  <% if (wallPage.nextCursor) { %><a class="button-secondary mt-6 inline-flex" href="/profile/<%= userProfile.name %>/wall-posts?before=<%= wallPage.nextCursor %>" hx-get="/profile/<%= userProfile.name %>/wall-posts?before=<%= wallPage.nextCursor %>" hx-target="#profile-content">Older wall messages</a><% } %>
</section>
