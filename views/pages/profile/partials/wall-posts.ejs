<section data-m18-3-surface="wall" aria-labelledby="wall-heading">
  <header class="py-3">
    <p class="app-kicker">Public wall</p>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="wall-heading" class="app-section-title">@<%= userProfile.name %>’s Wall</h2>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-gray-300">Posting a wall message costs at least <strong class="text-white"><%= profileSettings.wallFee %></strong>. Public wall messages and payment details are permanently visible on Hive.</p>
      </div>
      <p class="message-surface__context"><strong><%= profileSettings.wallFee %></strong> minimum · Public on Hive</p>
    </div>
  </header>

  <% const wallEnabled = canWriteAction('wall'); %>
  <% const inboxEnabled = canWriteAction('inbox'); %>
  <% if (hiveSession) { %>
    <% if (wallEnabled || inboxEnabled) { %>
      <% const privateOnly = !wallEnabled && inboxEnabled; %>
      <% const wallFields = []; %>
      <% if (inboxEnabled) { %>
        <% wallFields.push({
          id: 'wall-encrypt-message',
          name: 'encryptMessage',
          type: 'checkbox',
          role: 'wall-privacy-toggle',
          label: 'Encrypt this message (private)',
          value: 'true',
          checked: privateOnly,
          disabled: privateOnly,
          help: wallEnabled
            ? 'Unchecked messages are public on Hive. Checked messages are encrypted with Hive Keychain in this browser before review.'
            : 'Private messaging is the only available message mode here.',
        }); %>
      <% } %>
      <% wallFields.push({
        id: 'wall-message',
        name: 'message',
        type: 'textarea',
        role: 'wall-message',
        label: privateOnly ? `Private message for @${userProfile.name}` : 'Your message',
        required: true,
        maxBytes: privateOnly ? 1500 : 2000,
        rows: 4,
        size: 'medium',
        placeholder: privateOnly ? `Private message for @${userProfile.name}` : `Write on @${userProfile.name}’s Wall`,
      }); %>
      <%- include('../../../common/composer', { composer: {
        id: 'wall-message-composer',
        controller: 'm4',
        action: privateOnly ? 'inbox' : 'wall',
        dialog: true,
        triggerVariant: 'secondary',
        triggerLabel: wallEnabled
          ? (inboxEnabled ? 'Write a message' : 'Write on the wall')
          : 'Send a private message',
        kicker: privateOnly ? 'Private message' : 'Wall message',
        title: privateOnly ? 'Send a private message' : 'Post a public message',
        description: privateOnly
          ? `Keychain encrypts this message for @${userProfile.name} in this browser.`
          : `Write something for @${userProfile.name} and everyone who visits this Wall.`,
        meta: `${profileSettings.wallFee} · ${privateOnly ? 'Encrypted text' : 'Public on Hive'}`,
        wallPrivacy: { wallEnabled, inboxEnabled },
        hiddenFields: [
          { name: 'recipient', value: userProfile.name },
          { name: 'expectedFee', value: profileSettings.wallFee },
          { name: 'amount', value: profileSettings.wallFee },
        ],
        fields: wallFields,
        submitLabel: privateOnly ? 'Encrypt & review payment' : `Review message and ${profileSettings.wallFee} payment`,
        disclosure: privateOnly
          ? 'Keychain encrypts the message in this browser. The message text stays private, but sender, recipient, HBD amount, time, and transaction remain public on Hive. Encryption happens before review.'
          : 'The message, sender, recipient, payment, and transaction are permanently public on Hive. You’ll review the recipient, message, fee, and payment before Keychain asks for approval.',
      } }) %>
    <% } else { %>
      <p class="mt-5 rounded-lg border border-gray-700 bg-black/40 p-3 text-sm text-gray-400">Wall and private messaging aren’t available here yet.</p>
    <% } %>
  <% } else { %>
    <p class="mt-5 border-l-4 border-gray-700 py-2 pl-4 text-sm leading-6 text-gray-300">Sign in with Hive Keychain to write on this wall or send a private message. Reading public wall messages never requires signing in.</p>
  <% } %>

  <section class="message-surface mt-8" aria-labelledby="public-wall-messages-heading">
    <div class="message-surface__heading">
      <div>
        <p class="app-kicker">On the wall</p>
        <h3 id="public-wall-messages-heading" class="mt-2 text-xl font-bold">Public messages</h3>
      </div>
      <span class="message-surface__context">Permanent on Hive</span>
    </div>

    <% if (wallPage.items.length > 0) { %>
      <div class="message-list" data-message-list="wall">
        <% wallPage.items.forEach((item) => { %>
          <% const senderProfile = messageProfiles[item.sender] || {}; %>
          <% const senderDisplayName = senderProfile.displayName || item.sender; %>
          <article class="message-entry message-entry--wall" data-message-entry data-message-kind="wall">
            <header class="message-entry__identity">
              <div class="social-author">
                <% if (senderProfile.profileImage) { %>
                  <img class="message-entry__avatar" src="<%= senderProfile.profileImage %>" alt="" width="40" height="40" loading="lazy">
                <% } else { %>
                  <span class="message-entry__avatar message-entry__avatar--fallback" aria-hidden="true"><%= item.sender.slice(0, 1).toUpperCase() %></span>
                <% } %>
                <div class="social-author__text">
                  <a class="social-author__name" href="/profile/<%= item.sender %>"><%= senderDisplayName %></a>
                  <div class="social-author__meta">
                    <span>@<%= item.sender %></span>
                    <time datetime="<%= item.timestamp %>"><%= formatHiveDate(item.timestamp) %></time>
                  </div>
                </div>
              </div>
            </header>
            <p class="message-entry__body"><%= item.message %></p>
            <footer class="message-entry__activity">
              <span class="message-entry__amount"><span class="sr-only">Payment: </span><%= item.amount %></span>
              <details class="message-entry__details">
                <summary>Transaction details</summary>
                <p>Block <%= item.blockNumber || 'pending' %> · transaction <code><%= item.transactionId %></code></p>
              </details>
            </footer>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <p class="message-surface__empty">No public wall messages yet.</p>
    <% } %>
  </section>

  <% if (wallPage.nextCursor) { %>
    <a class="button-secondary mt-6 inline-flex" href="/profile/<%= userProfile.name %>/wall-posts?before=<%= wallPage.nextCursor %>" hx-get="/profile/<%= userProfile.name %>/wall-posts?before=<%= wallPage.nextCursor %>" hx-target="#profile-content">Older wall messages</a>
  <% } %>
</section>
