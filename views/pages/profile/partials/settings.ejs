<section class="rounded-2xl border border-gray-700 bg-gray-900 p-5 sm:p-7" aria-labelledby="settings-heading">
  <p class="eyebrow">Verified-owner page</p>
  <h2 id="settings-heading" class="mt-2 text-2xl font-bold">Profile and wall settings</h2>
  <p class="mt-3 text-sm leading-6 text-gray-300">Hive-Bar re-fetches your latest posting metadata, changes only the fields shown here, preserves unrelated fields, and displays the exact diff before Keychain requests Posting authority.</p>

  <% if (!profileSettings.metadataValid) { %>
    <div class="mt-5 rounded-lg border border-red-500/60 bg-red-950/40 p-4 text-sm text-red-100" role="alert">
      Current <code>posting_json_metadata</code> is malformed. It can be viewed safely, but Hive-Bar will not overwrite it because unrelated fields cannot be preserved reliably.
    </div>
  <% } %>

  <form class="mt-6 space-y-5" data-m4-action="profile">
    <input type="hidden" name="baseRevision" value="<%= profileSettings.revision %>">
    <div>
      <label for="profile-display-name" class="block text-sm font-bold">Display name</label>
      <input id="profile-display-name" name="displayName" type="text" value="<%= profileSettings.displayName %>" maxlength="128" class="mt-2 w-full rounded-lg border border-gray-600 bg-black p-3 text-white">
    </div>
    <div>
      <label for="profile-about" class="block text-sm font-bold">About</label>
      <textarea id="profile-about" name="about" rows="5" data-max-bytes="512" class="mt-2 w-full rounded-lg border border-gray-600 bg-black p-3 text-white"><%= profileSettings.about %></textarea>
      <p class="mt-1 text-xs text-gray-400" data-byte-counter>0 / 512 UTF-8 bytes</p>
    </div>
    <div>
      <label for="profile-image" class="block text-sm font-bold">Profile image URL</label>
      <input id="profile-image" name="profileImage" type="url" value="<%= profileSettings.profileImage %>" placeholder="https://images.hive.blog/..." class="mt-2 w-full rounded-lg border border-gray-600 bg-black p-3 text-white">
      <p class="mt-1 text-xs text-gray-400">V1 accepts credential-free HTTPS URLs on <code>images.hive.blog</code>.</p>
    </div>
    <div>
      <label for="wall-fee" class="block text-sm font-bold">Minimum wall/inbox fee</label>
      <input id="wall-fee" name="wallFee" type="text" required pattern="[0-9]+\.[0-9]{3} HBD" value="<%= profileSettings.wallFee %>" class="mt-2 w-full rounded-lg border border-gray-600 bg-black p-3 text-white">
      <p class="mt-1 text-xs text-gray-400">Use canonical three-decimal HBD, for example <code>1.000 HBD</code>.</p>
    </div>
    <div>
      <label for="wall-blocklist" class="block text-sm font-bold">Profile-managed sender exclusions</label>
      <textarea id="wall-blocklist" name="blocklist" rows="5" class="mt-2 w-full rounded-lg border border-gray-600 bg-black p-3 font-mono text-sm text-white"><%= profileSettings.blocklist.join('\n') %></textarea>
      <p class="mt-1 text-xs text-gray-400">One Hive account per line, up to 100. These combine with the server-configured global exclusion list.</p>
    </div>
    <% if (writesEnabled && profileSettings.metadataValid) { %>
      <button type="submit" class="button-primary">Review exact metadata diff</button>
    <% } else { %>
      <button type="button" class="button-primary" disabled>Profile signing unavailable</button>
    <% } %>
    <p class="text-xs text-gray-300" aria-live="polite" data-m4-status>
      <% if (!writesEnabled) { %>Signing is disabled until an individually authorized controlled-write run.<% } %>
    </p>
  </form>
</section>
