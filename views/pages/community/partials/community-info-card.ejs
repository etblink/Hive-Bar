<section class="community-about-panel" aria-labelledby="community-about-heading">
  <h2 id="community-about-heading">About this community</h2>
  <% if (communityInfo.aboutHtml) { %>
    <div class="community-about-panel__about prose"><%- communityInfo.aboutHtml %></div>
  <% } else { %>
    <p class="community-about-panel__about">The 4th Street Bar community is getting started on Hive.</p>
  <% } %>

  <dl class="community-about-panel__stats">
    <div class="stat-tile">
      <dt>Subscribers</dt>
      <dd><%= communityInfo.subscriberCount.toLocaleString() %></dd>
    </div>
    <div class="stat-tile">
      <dt>Pending rewards</dt>
      <dd>$<%= formatNumber(communityInfo.pendingRewards, 2) %></dd>
    </div>
  </dl>

  <p class="community-about-panel__source">
    Public data from Hive community <strong class="text-gray-200"><%= communityInfo.name %></strong>.
  </p>

  <% if (hiveSession && canWriteAction(membership ? 'unsubscribe' : 'subscribe') && membership !== null) { %>
    <form class="mt-4" data-social-action="<%= membership ? 'unsubscribe' : 'subscribe' %>">
      <button type="submit" class="button-primary w-full">
        <%= membership ? 'Unsubscribe' : 'Subscribe' %>
      </button>
      <p class="mt-2 text-xs text-gray-300" aria-live="polite" data-social-status>
        Current on-chain state: <%= membership ? 'subscribed' : 'not subscribed' %>.
      </p>
    </form>
  <% } else if (hiveSession && !writesEnabled) { %>
    <p class="mt-4 rounded-lg border border-gray-700 p-3 text-sm text-gray-400">
      Social signing is disabled until an individually authorized controlled-write run.
    </p>
  <% } else if (!hiveSession) { %>
    <p class="mt-4 text-sm text-gray-400">Sign in with Hive Keychain to subscribe.</p>
  <% } %>
</section>
