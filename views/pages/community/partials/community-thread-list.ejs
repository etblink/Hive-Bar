<% if (hiveSession && canWriteAction('thread') && container) { %>
  <section class="social-composer thread-composer mt-4" aria-labelledby="thread-composer-heading">
    <div class="thread-composer__intro">
      <p class="eyebrow">Start a conversation</p>
      <h2 id="thread-composer-heading">Start a Thread</h2>
      <p>Share a quick thought with the 4th Street Bar community.</p>
    </div>
    <form class="mt-4 space-y-3" data-social-action="thread" data-signer-mode="<%= signerMode %>">
      <div>
        <label class="thread-composer__label" for="new-thread-body">What do you want to share?</label>
        <textarea id="new-thread-body" name="body" required rows="4" data-max-bytes="500" aria-describedby="new-thread-counter new-thread-help new-thread-status" placeholder="What’s happening?" class="thread-composer__input"></textarea>
        <div class="thread-composer__actions">
          <p id="new-thread-counter" class="text-xs text-gray-400" data-byte-counter>0 / 500 used</p>
          <button type="submit" class="button-primary">Review Thread</button>
        </div>
      </div>
      <p id="new-thread-help" class="thread-composer__help">You’ll review your Thread before Hive Keychain asks you to approve it.</p>
      <p id="new-thread-status" class="text-sm text-gray-300" aria-live="polite" data-social-status></p>
    </form>
  </section>
<% } %>
<% if (threads.length > 0) { %>
  <div class="thread-feed space-y-4" role="feed" aria-label="Community Threads">
    <% threads.forEach((thread) => { %>
      <%- include('../../../common/comment', { comment: thread, userProfile: profiles[thread.author] }) %>
    <% }); %>
  </div>
<% } else { %>
  <section class="state-card">
    <p class="eyebrow">Short-form community</p>
    <h2>No threads yet</h2>
    <% if (container) { %>
      <p>Be the first to start a short conversation with the community.</p>
    <% } else { %>
      <p>Threads aren’t available yet.</p>
    <% } %>
  </section>
<% } %>
