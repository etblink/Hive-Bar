<% if (hiveSession && canWriteAction('thread') && container) { %>
  <div class="composer-toolbar" role="toolbar" aria-label="Thread actions">
    <%- include('../../../common/composer', { composer: {
      id: 'thread-composer',
      controller: 'social',
      action: 'thread',
      signerMode,
      dialog: true,
      triggerVariant: 'icon',
      triggerLabel: 'Start a Thread',
      triggerAriaLabel: 'Start a Thread',
      triggerTitle: 'Start a Thread',
      kicker: 'Start a conversation',
      title: 'Start a Thread',
      description: 'Share a quick thought with the 4th Street Bar community.',
      meta: 'Short-form · 500 bytes',
      imageAttachment: true,
      fields: [
        { id: 'new-thread-body', name: 'body', type: 'textarea', label: 'What do you want to share?', required: true, maxBytes: 500, rows: 4, size: 'medium', placeholder: 'What’s happening?' },
      ],
      submitLabel: 'Review Thread',
      disclosure: 'You’ll review your Thread and attached image URL before Hive Keychain asks you to approve it. The image reference counts toward the 500-byte Thread limit.',
    } }) %>
  </div>
<% } %>
<% if (threads.length > 0) { %>
  <div class="thread-feed" role="feed" aria-label="Community Threads">
    <% threads.forEach((thread) => { %>
      <%- include('../../../common/comment', { comment: thread, userProfile: profiles[thread.author], commentContext: 'thread' }) %>
    <% }); %>
  </div>
<% } else { %>
  <section class="state-card">
    <p class="eyebrow">Short-form community</p>
    <h2>No threads yet</h2>
    <% if (container) { %>
      <p>Be the first to start a short conversation with the community.</p>
    <% } else { %>
      <p>Threads aren’t available yet.</p>
    <% } %>
  </section>
<% } %>
