<% if (hiveSession && canWriteAction('thread') && container) { %>
  <details class="mb-5 rounded-xl border border-gray-700 bg-gray-900 p-4">
    <summary class="cursor-pointer font-bold text-bar-gold">Create a thread</summary>
    <form class="mt-4 space-y-4" data-social-action="thread">
      <div>
        <label class="block text-sm font-bold text-gray-200" for="new-thread-body">Thread text</label>
        <textarea id="new-thread-body" name="body" required rows="4" data-max-bytes="500" class="mt-2 w-full rounded-lg border border-gray-600 bg-black px-3 py-3 text-white"></textarea>
        <p class="mt-1 text-xs text-gray-400" data-byte-counter>0 / 500 UTF-8 bytes</p>
      </div>
      <button type="submit" class="button-primary">Review thread</button>
      <p class="text-sm text-gray-300" aria-live="polite" data-social-status></p>
    </form>
  </details>
<% } %>
<% if (threads.length > 0) { %>
  <section class="mb-5 rounded-xl border border-gray-700 bg-gray-900 p-4" aria-labelledby="thread-container-heading">
    <h2 id="thread-container-heading" class="font-bold text-bar-gold">Current thread container</h2>
    <a href="/post/<%= container.author %>/<%= container.permlink %>" class="mt-1 block break-words text-gray-200 underline">
      @<%= container.author %>/<%= container.permlink %>
    </a>
  </section>
  <div class="space-y-4">
    <% threads.forEach((thread) => { %>
      <%- include('../../../common/comment', { comment: thread, userProfile: profiles[thread.author] }) %>
    <% }); %>
  </div>
<% } else { %>
  <section class="state-card">
    <p class="eyebrow">Short-form community</p>
    <h2>No threads yet</h2>
    <% if (container) { %>
      <p>The container exists, but nobody has replied to it yet.</p>
    <% } else { %>
      <p>Short-form discussion will appear here after @<%= threadsContainerAccount %> publishes its first container post.</p>
    <% } %>
  </section>
<% } %>
