<% const canCreatePost = hiveSession && canWriteAction('post'); %>
<div class="community-feed-toolbar">
  <% if (canCreatePost) { %>
    <div class="composer-toolbar" role="toolbar" aria-label="Post actions">
      <%- include('../../../common/composer', { composer: {
        id: 'community-post-composer',
        controller: 'social',
        action: 'post',
        signerMode,
        dialog: true,
        triggerVariant: 'icon',
        triggerLabel: 'Create post',
        triggerAriaLabel: 'Create post',
        triggerTitle: 'Create post',
        kicker: 'Create post',
        title: 'Share something',
        description: 'Choose where this post should appear, then write it without leaving the conversation.',
        meta: 'Posting as your verified Hive account',
        imageAttachment: true,
        fields: [
          { id: 'new-post-destination', name: 'destination', type: 'select', label: 'Destination', required: true, value: 'community', options: [
            { value: 'community', label: '4th Street Bar community' },
            { value: 'profile', label: 'My profile' },
          ], help: 'The destination is included in the exact review before Keychain opens.' },
          { id: 'new-post-title', name: 'title', type: 'text', label: 'Title', required: true, maxBytes: 256, placeholder: 'Give your post a clear title', autocomplete: 'off' },
          { id: 'new-post-body', name: 'body', type: 'textarea', label: 'Post', required: true, maxBytes: 32768, rows: 8, size: 'large', placeholder: 'What do you want to share?' },
          { id: 'new-post-tags', name: 'tags', type: 'text', label: 'Tags', placeholder: 'reno, nightlife', autocomplete: 'off', help: 'Separate tags with commas. Community posts add the bar community automatically. Profile posts use your first tag as the category, or blog if you leave tags blank.' },
        ],
        submitLabel: 'Review post',
        disclosure: 'You’ll review the exact post, attached image URL, and destination before Hive Keychain asks you to approve it.',
      } }) %>
    </div>
  <% } %>

  <form action="/community" method="get" hx-get="/community/<%= communityName %>/community-posts" hx-target="#community-feed" class="community-sort">
    <div class="community-sort__field">
      <label for="community-sort" class="community-sort__label">Sort posts</label>
      <select id="community-sort" name="sort" data-community-sort class="community-sort__select">
        <% for (const sort of ['created', 'trending', 'hot', 'payout']) { %>
          <option value="<%= sort %>" <%= postsPage.sort === sort ? 'selected' : '' %>><%= sort[0].toUpperCase() + sort.slice(1) %></option>
        <% } %>
      </select>
    </div>
    <button type="submit" class="button-secondary community-sort__submit">Apply sort</button>
  </form>
</div>

<% if (postsPage.items.length > 0) { %>
  <ul class="social-feed" aria-label="Community posts">
    <% postsPage.items.forEach((post) => { %>
      <li class="social-feed-item"><%- include('../../../common/post', { post, userProfile: postsPage.profiles[post.author] }) %></li>
    <% }); %>
  </ul>
  <% if (postsPage.nextCursor) { %>
    <nav class="mt-6 flex justify-center" aria-label="Community post pagination">
      <a href="/community?sort=<%= postsPage.sort %>&after=<%= postsPage.nextCursor %>" hx-get="/community/<%= communityName %>/community-posts?sort=<%= postsPage.sort %>&after=<%= postsPage.nextCursor %>" hx-target="#community-feed" class="button-secondary">Next page</a>
    </nav>
  <% } %>
<% } else { %>
  <section class="state-card mt-4">
    <p class="eyebrow">Community posts</p>
    <h2>The conversation is just getting started</h2>
    <p>No posts here yet. New posts will appear as the community gets the conversation going.</p>
  </section>
<% } %>
