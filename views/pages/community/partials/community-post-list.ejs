<% if (hiveSession && canWriteAction('post')) { %>
  <%- include('../../../common/composer', { composer: {
    id: 'community-post-composer',
    controller: 'social',
    action: 'post',
    signerMode,
    collapsible: true,
    kicker: 'Community post',
    title: 'Create a community post',
    description: 'Share news, a story, or something worth discussing with the community.',
    meta: '4th Street Bar community',
    fields: [
      { id: 'new-post-title', name: 'title', type: 'text', label: 'Title', required: true, maxBytes: 256, placeholder: 'Give your post a clear title', autocomplete: 'off' },
      { id: 'new-post-body', name: 'body', type: 'textarea', label: 'Post', required: true, maxBytes: 32768, rows: 8, size: 'large', placeholder: 'What do you want the community to know?' },
      { id: 'new-post-tags', name: 'tags', type: 'text', label: 'Tags', placeholder: 'reno, nightlife', autocomplete: 'off', help: 'Separate tags with commas. We’ll add the community tag for you.' },
    ],
    submitLabel: 'Review post',
    disclosure: 'You’ll review the post and its destination before Hive Keychain asks you to approve it.',
  } }) %>
<% } %>

<form action="/community" method="get" hx-get="/community/<%= communityName %>/community-posts" hx-target="#community-feed" class="community-sort mt-4">
  <div class="community-sort__field">
    <label for="community-sort" class="community-sort__label">Sort posts</label>
    <select id="community-sort" name="sort" data-community-sort class="community-sort__select">
      <% for (const sort of ['created', 'trending', 'hot', 'payout']) { %>
        <option value="<%= sort %>" <%= postsPage.sort === sort ? 'selected' : '' %>><%= sort[0].toUpperCase() + sort.slice(1) %></option>
      <% } %>
    </select>
  </div>
  <button type="submit" class="button-secondary community-sort__submit">Apply sort</button>
</form>

<% if (postsPage.items.length > 0) { %>
  <ul class="social-feed" aria-label="Community posts">
    <% postsPage.items.forEach((post) => { %>
      <li class="social-feed-item"><%- include('../../../common/post', { post, userProfile: postsPage.profiles[post.author] }) %></li>
    <% }); %>
  </ul>
  <% if (postsPage.nextCursor) { %>
    <nav class="mt-6 flex justify-center" aria-label="Community post pagination">
      <a href="/community?sort=<%= postsPage.sort %>&after=<%= postsPage.nextCursor %>" hx-get="/community/<%= communityName %>/community-posts?sort=<%= postsPage.sort %>&after=<%= postsPage.nextCursor %>" hx-target="#community-feed" class="button-secondary">Next page</a>
    </nav>
  <% } %>
<% } else { %>
  <section class="state-card mt-4">
    <p class="eyebrow">Community posts</p>
    <h2>The conversation is just getting started</h2>
    <p>No posts here yet. New posts will appear as the community gets the conversation going.</p>
  </section>
<% } %>
