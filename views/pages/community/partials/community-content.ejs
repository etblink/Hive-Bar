<section class="flex flex-1 flex-col bg-gray-950 py-8 sm:py-12" aria-labelledby="community-heading">
  <div class="container mx-auto flex flex-1 flex-col px-4 sm:px-6">
    <p class="eyebrow text-center"><%= communityInfo.name %></p>
    <h1 id="community-heading" class="mb-8 mt-2 text-center text-3xl font-bold text-white sm:text-4xl"><%= communityInfo.title %></h1>
    <div class="grid flex-1 grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <aside>
        <%- include('community-info-card') %>
      </aside>
      <div class="min-w-0">
        <nav class="mb-5 grid grid-cols-2 gap-2" aria-label="Community content">
          <a
            href="/community"
            hx-get="/community/<%= communityName %>/community-posts?sort=created"
            hx-target="#community-feed"
            class="content-tab <%= activeView === 'posts' ? 'content-tab--active' : '' %>"
            <% if (activeView === 'posts') { %>aria-current="page"<% } %>>
            Community posts
          </a>
          <a
            href="/community/threads"
            hx-get="/community/threads"
            hx-target="#community-feed"
            class="content-tab <%= activeView === 'threads' ? 'content-tab--active' : '' %>"
            <% if (activeView === 'threads') { %>aria-current="page"<% } %>>
            Threads
          </a>
        </nav>
        <div id="community-feed" class="min-w-0" aria-live="polite">
          <% if (activeView === 'threads') { %>
            <%- include('community-thread-list', {
              container: threadsData.container,
              threads: threadsData.threads,
              profiles: threadsData.profiles,
              threadsContainerAccount
            }) %>
          <% } else if (feedError) { %>
            <section class="state-card" role="status">
              <h2>Posts are temporarily unavailable</h2>
              <p>The community itself is online, but its post feed could not be loaded. Nothing else on this page is affected.</p>
              <a href="/community" class="button-secondary mt-5">Try the feed again</a>
            </section>
          <% } else { %>
            <%- include('community-post-list', { postsPage, communityName }) %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>
