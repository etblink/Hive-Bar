<section class="flex flex-1 flex-col bg-gray-900 py-8">
  <div class="container mx-auto flex flex-1 flex-col px-4 sm:px-6">
    <p class="text-center text-sm font-bold uppercase tracking-widest text-gray-400"><%= communityInfo.name %></p>
    <h1 class="mb-8 mt-2 text-center text-3xl font-bold text-bar-gold sm:text-4xl"><%= communityInfo.title %></h1>
    <div class="grid flex-1 grid-cols-1 gap-8 lg:grid-cols-3">
      <aside class="lg:col-span-1">
        <%- include('community-info-card') %>
      </aside>
      <div class="flex flex-col lg:col-span-2">
        <div class="flex flex-1 flex-col overflow-hidden rounded-lg" data-tab-group>
          <div class="mb-4 flex gap-1 bg-gray-800" role="tablist" aria-label="Community content">
            <button
              type="button"
              role="tab"
              aria-selected="true"
              data-tab-button
              hx-get="/community/threads"
              hx-target="#postContent"
              hx-trigger="click, load"
              class="flex-1 rounded-t-lg bg-bar-gold px-4 py-3 font-bold text-black">
              Threads
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-tab-button
              hx-get="/community/<%= communityInfo.name %>/community-posts"
              hx-target="#postContent"
              hx-trigger="click"
              class="flex-1 rounded-t-lg bg-gray-700 px-4 py-3 font-bold text-white">
              Community posts
            </button>
          </div>
          <div id="postContent" class="max-h-community flex-grow space-y-6 overflow-y-auto" aria-live="polite">
            <p class="rounded-lg bg-gray-800 p-6 text-gray-300">Loading community activity…</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
