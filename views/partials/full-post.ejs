<article class="rounded-lg bg-gray-800 p-6">
  <a
    href="/community"
    hx-get="/community/<%= communityName %>/community-posts"
    hx-target="#postContent"
    class="mb-5 inline-flex items-center rounded px-2 py-1 text-bar-gold hover:bg-gray-700 hover:text-white">
    <span aria-hidden="true">←</span><span class="ml-2">Back to community posts</span>
  </a>

  <header class="mb-4 flex items-center border-b border-gray-700 pb-4">
    <img src="https://images.hive.blog/u/<%= post.author %>/avatar" alt="" class="mr-4 h-12 w-12 rounded-full" width="48" height="48">
    <div>
      <a href="/profile/<%= post.author %>" class="text-lg font-semibold text-bar-gold hover:underline">@<%= post.author %></a>
      <p class="text-sm text-gray-400"><%= new Date(post.created).toLocaleString() %></p>
    </div>
  </header>

  <h1 class="mb-4 text-2xl font-bold"><%= post.title || 'Untitled post' %></h1>
  <div class="prose prose-invert max-w-none break-words">
    <%- post.parsedBody %>
  </div>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-gray-700 pt-4 text-sm">
    <span class="text-gray-300"><%= Number(post.likes || 0).toLocaleString() %> positive votes</span>
    <span class="text-bar-gold">Pending: $<%= formatPayout(post) %></span>
  </div>

  <section class="mt-8" aria-labelledby="commentsHeading">
    <h2 id="commentsHeading" class="mb-4 text-xl font-bold">Comments</h2>
    <% if (comments && comments.length > 0) { %>
      <% comments.forEach((comment) => { %>
        <%- include('../common/comment', { comment }) %>
      <% }); %>
    <% } else { %>
      <p class="text-gray-400">No comments yet.</p>
    <% } %>
  </section>
</article>
