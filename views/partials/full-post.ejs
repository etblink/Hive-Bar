<article class="conversation-post">
  <header>
    <div class="social-author">
      <img src="<%= profiles[post.author]?.profileImage || `https://images.hive.blog/u/${post.author}/avatar` %>" alt="" class="h-12 w-12 shrink-0 rounded-full bg-gray-800" width="48" height="48">
      <div class="social-author__text">
        <a href="/profile/<%= post.author %>" class="social-author__name"><%= profiles[post.author]?.displayName || `@${post.author}` %></a>
        <div class="social-author__meta"><span>@<%= post.author %></span><span aria-hidden="true">·</span><time datetime="<%= post.created %>"><%= formatHiveDate(post.created) %></time></div>
      </div>
    </div>
    <p class="app-kicker mt-5">Community post</p>
    <h1 class="conversation-post__title break-words"><%= post.title %></h1>
  </header>
  <div class="conversation-post__body prose max-w-none break-words text-gray-200"><%- post.bodyHtml %></div>
  <footer class="conversation-post__stats" aria-label="Post activity">
    <span><%= post.positiveVotes.toLocaleString() %> upvotes</span>
    <% if (post.negativeVotes > 0) { %><span><%= post.negativeVotes.toLocaleString() %> downvotes</span><% } %>
    <span class="text-bar-gold">$<%= formatPayout(post) %></span>
  </footer>
  <%- include('../common/vote-form', { item: post }) %>
</article>

<section class="conversation-comments" aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="conversation-comments__heading">Replies <span class="text-gray-400">(<%= comments.length %>)</span></h2>
  <% if (hiveSession && canWriteAction('comment')) { %>
    <form class="social-composer mt-4 space-y-4" data-social-action="comment" data-signer-mode="<%= signerMode %>">
      <input type="hidden" name="parentAuthor" value="<%= post.author %>">
      <input type="hidden" name="parentPermlink" value="<%= post.permlink %>">
      <div>
        <label class="block text-sm font-bold text-gray-200" for="new-comment-body">Add a reply</label>
        <textarea id="new-comment-body" name="body" required rows="5" data-max-bytes="8192" class="mt-2 w-full rounded-lg border border-gray-600 bg-black px-3 py-3 text-white"></textarea>
        <p class="mt-1 text-xs text-gray-400" data-byte-counter>0 / 8,192 used</p>
      </div>
      <button type="submit" class="button-primary">Review reply</button>
      <p class="text-sm text-gray-300" aria-live="polite" data-social-status></p>
    </form>
  <% } %>
  <% if (comments.length > 0) { %>
    <div class="mt-4" data-comment-thread>
      <% comments.forEach((comment) => { %><%- include('../common/comment', { comment, userProfile: profiles[comment.author] }) %><% }); %>
    </div>
  <% } else { %>
    <section class="state-card mt-4"><p class="eyebrow">Conversation</p><h2>No replies yet</h2><p>Replies will appear here as people join the conversation.</p></section>
  <% } %>
</section>
