<article class="rounded-2xl border border-gray-700 bg-gray-900 p-5 sm:p-8">
  <header>
    <p class="eyebrow">Hive post</p>
    <h1 class="mt-2 break-words text-3xl font-bold text-white sm:text-4xl"><%= post.title %></h1>
    <div class="mt-5 flex min-w-0 items-center gap-3">
      <img
        src="<%= profiles[post.author]?.profileImage || `https://images.hive.blog/u/${post.author}/avatar` %>"
        alt=""
        class="h-12 w-12 shrink-0 rounded-full bg-gray-800"
        width="48"
        height="48">
      <div class="min-w-0">
        <a href="/profile/<%= post.author %>" class="block truncate font-bold text-bar-gold">@<%= post.author %></a>
        <time datetime="<%= post.created %>" class="block text-sm text-gray-400"><%= formatHiveDate(post.created) %></time>
      </div>
    </div>
  </header>
  <div class="prose mt-8 max-w-none break-words text-gray-200">
    <%- post.bodyHtml %>
  </div>
  <footer class="mt-8 flex flex-wrap gap-4 border-t border-gray-700 pt-5 text-sm text-gray-400">
    <span><%= post.positiveVotes.toLocaleString() %> positive votes</span>
    <% if (post.negativeVotes > 0) { %><span><%= post.negativeVotes.toLocaleString() %> downvotes</span><% } %>
    <span class="text-bar-gold">$<%= formatPayout(post) %></span>
  </footer>
</article>

<section class="mt-8" aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="text-2xl font-bold text-white">Comments <span class="text-gray-400">(<%= comments.length %>)</span></h2>
  <% if (comments.length > 0) { %>
    <div class="mt-5 space-y-4">
      <% comments.forEach((comment) => { %>
        <%- include('../common/comment', { comment, userProfile: profiles[comment.author] }) %>
      <% }); %>
    </div>
  <% } else { %>
    <p class="mt-4 rounded-xl border border-gray-700 bg-gray-900 p-6 text-gray-300">No comments have been posted yet.</p>
  <% } %>
</section>
