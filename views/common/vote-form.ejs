<% const betaVoteEnabled = Boolean(config?.hive?.betaSelfSigningEnabled); %>
<% if (hiveSession && (canWriteAction('vote') || betaVoteEnabled)) { %>
  <form
    class="mt-4 flex flex-wrap items-end gap-3"
    data-social-action="vote"
    data-signer-mode="<%= signerMode %>">
    <input type="hidden" name="author" value="<%= item.author %>">
    <input type="hidden" name="permlink" value="<%= item.permlink %>">
    <div>
      <label class="block text-xs font-bold text-gray-300" for="vote-direction-<%= item.author %>-<%= item.permlink %>">Vote</label>
      <select
        id="vote-direction-<%= item.author %>-<%= item.permlink %>"
        name="direction"
        required
        class="mt-1 rounded border border-gray-600 bg-black px-3 py-2 text-white">
        <option value="upvote">Upvote</option>
        <option value="downvote">Downvote</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-bold text-gray-300" for="vote-<%= item.author %>-<%= item.permlink %>">Strength</label>
      <div class="mt-1 flex items-center gap-2">
        <input
          id="vote-<%= item.author %>-<%= item.permlink %>"
          type="number"
          name="percent"
          value="100"
          min="1"
          max="100"
          step="1"
          required
          class="w-24 rounded border border-gray-600 bg-black px-3 py-2 text-white">
        <span class="text-sm text-gray-300" aria-hidden="true">%</span>
      </div>
    </div>
    <button type="submit" class="button-secondary">Review vote</button>
    <p class="w-full text-xs text-gray-400">Choose an upvote or downvote and how strongly you want to vote. You’ll review it before Keychain asks for approval.</p>
    <p class="w-full text-xs text-gray-300" aria-live="polite" data-social-status></p>
  </form>
<% } %>
