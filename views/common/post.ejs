<article>
  <header class="flex min-w-0 items-center gap-3">
    <img
      src="<%= userProfile?.profileImage || `https://images.hive.blog/u/${post.author}/avatar` %>"
      alt=""
      class="h-11 w-11 shrink-0 rounded-full bg-gray-800"
      width="44"
      height="44"
      loading="lazy">
    <div class="min-w-0">
      <a href="/profile/<%= post.author %>" class="block truncate font-bold text-white hover:text-bar-gold">
        <%= userProfile?.displayName || `@${post.author}` %>
      </a>
      <p class="truncate text-sm text-gray-400">@<%= post.author %></p>
    </div>
  </header>
  <h2 class="mt-4 break-words text-xl font-bold text-bar-gold sm:text-2xl">
    <a href="/post/<%= post.author %>/<%= post.permlink %>" class="hover:underline"><%= post.title %></a>
  </h2>
  <% if (post.excerpt) { %>
    <p class="mt-3 break-words leading-7 text-gray-300"><%= post.excerpt %></p>
  <% } %>
  <footer class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-400">
    <time datetime="<%= post.created %>"><%= formatHiveDate(post.created) %></time>
    <span><%= post.positiveVotes.toLocaleString() %> positive votes</span>
    <% if (post.negativeVotes > 0) { %><span><%= post.negativeVotes.toLocaleString() %> downvotes</span><% } %>
    <span><%= post.replyCount.toLocaleString() %> replies</span>
    <span class="text-bar-gold">$<%= formatPayout(post) %></span>
  </footer>
  <%- include('vote-form', { item: post }) %>
</article>
