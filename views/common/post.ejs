<article class="social-post">
  <header class="social-author">
    <img
      src="<%= userProfile?.profileImage || `https://images.hive.blog/u/${post.author}/avatar` %>"
      alt=""
      class="h-11 w-11 shrink-0 rounded-full bg-gray-800"
      width="44"
      height="44"
      loading="lazy">
    <div class="social-author__text">
      <a href="/profile/<%= post.author %>" class="social-author__name">
        <%= userProfile?.displayName || `@${post.author}` %>
      </a>
      <div class="social-author__meta">
        <span>@<%= post.author %></span>
        <span aria-hidden="true">·</span>
        <time datetime="<%= post.created %>"><%= formatHiveDate(post.created) %></time>
      </div>
    </div>
  </header>

  <div class="social-post__content">
    <h2 class="social-post__title break-words">
      <a href="/post/<%= post.author %>/<%= post.permlink %>"><%= post.title %></a>
    </h2>
    <% if (post.primaryImage) { %>
      <a class="social-post__media" href="/post/<%= post.author %>/<%= post.permlink %>" aria-label="Open <%= post.title %>">
        <img src="<%= post.primaryImage %>" alt="" loading="lazy" decoding="async">
      </a>
    <% } %>
    <% if (post.excerpt) { %>
      <p class="social-post__excerpt break-words"><%= post.excerpt %></p>
    <% } %>
  </div>

  <div class="social-post__activity">
    <footer class="social-post__stats" aria-label="Post activity">
      <span><%= post.positiveVotes.toLocaleString() %> upvotes</span>
      <% if (post.negativeVotes > 0) { %><span><%= post.negativeVotes.toLocaleString() %> downvotes</span><% } %>
      <span><%= post.replyCount.toLocaleString() %> replies</span>
      <span class="text-bar-gold">$<%= formatPayout(post) %></span>
    </footer>
    <div class="social-action-row" role="group" aria-label="Post actions">
      <%- include('vote-form', { item: post }) %>
      <%- include('share-action', { item: post }) %>
    </div>
  </div>
</article>
