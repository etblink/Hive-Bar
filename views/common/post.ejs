<article class="border-b border-gray-600 pb-4">
  <header class="mb-4 flex items-center">
    <img
      src="<%= userProfile?.profile?.profileImage || `https://images.hive.blog/u/${post.author}/avatar` %>"
      alt=""
      class="mr-4 h-12 w-12 rounded-full"
      width="48"
      height="48"
      loading="lazy">
    <div>
      <a href="/profile/<%= post.author %>" class="text-lg font-semibold text-bar-gold hover:underline">@<%= post.author %></a>
      <p class="text-sm text-gray-400"><%= new Date(post.created).toLocaleString() %></p>
    </div>
  </header>
  <h2 class="mb-2 text-xl font-bold">
    <a
      href="/post/<%= post.author %>/<%= post.permlink %>"
      hx-get="/post/<%= post.author %>/<%= post.permlink %>"
      hx-target="#postContent"
      hx-push-url="true"
      class="hover:text-bar-gold">
      <%= post.title || 'Untitled post' %>
    </a>
  </h2>
  <p class="mb-4 text-gray-200"><%= post.excerpt || plainTextExcerpt(post.body, 200) || 'No content available.' %></p>
  <footer class="flex flex-wrap items-center justify-between gap-3 text-sm">
    <span class="text-gray-300"><%= Number(post.likes || 0).toLocaleString() %> positive votes</span>
    <span class="text-bar-gold">Pending: $<%= formatPayout(post) %></span>
  </footer>
</article>
