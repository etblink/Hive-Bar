<section class="app-state app-state--<%= stateKind %>" role="<%= announceRole %>">
  <p class="app-state__label"><%= stateLabel %></p>
  <h2 class="app-state__title"><%= pageTitle %></h2>
  <p class="app-state__message"><%= message %></p>
  <div class="app-state__actions">
    <a href="<%= primaryAction.href %>" class="button-primary"><%= primaryAction.label %></a>
    <% if (secondaryAction) { %>
      <a href="<%= secondaryAction.href %>" class="button-secondary"><%= secondaryAction.label %></a>
    <% } %>
  </div>
  <p class="app-state__reference">Reference: <%= requestId %></p>
</section>
