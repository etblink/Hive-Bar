<%
  const sharePath = `/post/${item.author}/${item.permlink}`;
%>
<button
  type="button"
  class="social-action-button social-action-button--share"
  data-share-post
  data-share-url="<%= sharePath %>"
  aria-label="Share post"
  title="Share post">
  <span class="social-action-button__glyph" aria-hidden="true">↗</span>
  <span class="sr-only">Share post</span>
</button>
