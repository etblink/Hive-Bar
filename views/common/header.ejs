<a href="#main-content" class="skip-link">Skip to main content</a>
<header class="w-full border-b border-gray-800 bg-black">
  <div class="container mx-auto flex flex-col items-center justify-between gap-3 px-4 py-4 sm:flex-row sm:px-6">
    <a href="/" class="flex min-w-0 items-center gap-3" aria-label="<%= siteName %> home">
      <span class="bar-mark" aria-hidden="true">4</span>
      <span class="truncate text-xl font-bold text-white sm:text-2xl"><%= siteName %></span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="flex flex-wrap items-center justify-center gap-1 sm:gap-3">
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/community" class="nav-link">Community</a></li>
        <li>
          <% if (hiveSession) { %>
            <div class="flex items-center gap-2">
              <a href="/profile/<%= hiveSession.account %>" class="nav-link">@<%= hiveSession.account %></a>
              <button type="button" class="rounded border border-gray-600 px-3 py-2 text-xs text-gray-200 hover:text-bar-gold" data-keychain-logout>
                Sign out
              </button>
            </div>
          <% } else { %>
            <details class="rounded border border-gray-700 bg-gray-950 p-2">
              <summary class="cursor-pointer px-2 py-1 text-sm font-bold text-bar-gold">Sign in</summary>
              <form class="mt-3 w-64 space-y-3 p-2" data-keychain-login>
                <label for="hive-login-account" class="block text-xs font-bold text-gray-200">Hive account</label>
                <input
                  id="hive-login-account"
                  name="account"
                  type="text"
                  required
                  minlength="3"
                  maxlength="64"
                  autocomplete="username"
                  autocapitalize="none"
                  spellcheck="false"
                  placeholder="your-account"
                  class="mt-1 w-full rounded border border-gray-600 bg-black px-3 py-2 text-sm text-white"
                >
                <button type="submit" class="button-primary w-full text-sm">Continue with Keychain</button>
                <p class="text-xs leading-6 text-gray-400">
                  Requires the
                  <a class="underline hover:text-bar-gold" href="https://hive-keychain.com" rel="noopener noreferrer">Hive Keychain extension</a>.
                  Never enter a private key here.
                </p>
                <p class="text-xs leading-6 text-gray-300" aria-live="polite" data-keychain-status></p>
              </form>
            </details>
          <% } %>
        </li>
      </ul>
    </nav>
    <% if (hiveSession) { %>
      <p class="w-full text-right text-xs text-gray-400" aria-live="polite" data-keychain-status></p>
    <% } %>
  </div>
</header>
