<%
  const shellPath = typeof requestPath === 'string' ? requestPath : '';
  const shellHomeActive = shellPath === '/';
  const shellThreadsActive = shellPath === '/community/threads';
  const shellCommunityActive =
    !shellThreadsActive && (shellPath.startsWith('/community') || shellPath.startsWith('/post/'));
  const shellYouPath = hiveSession ? `/profile/${hiveSession.account}` : '';
  const shellYouActive =
    Boolean(shellYouPath) && (shellPath === shellYouPath || shellPath.startsWith(`${shellYouPath}/`));
%>
<a href="#main-content" class="skip-link">Skip to main content</a>
<header class="app-shell-header [backdrop-filter:none]">
  <a href="/" class="app-brand" aria-label="<%= siteName %> home">
    <img
      src="/images/fourth-street-bar-logo.jpg"
      alt=""
      width="720"
      height="720"
      decoding="async"
      class="app-brand__logo max-w-full"
      data-bar-logo>
    <span class="app-brand__wordmark">
      <strong>4th Street Bar</strong>
      <span>Hive-Bar</span>
    </span>
  </a>

  <nav class="app-primary-nav" aria-label="Primary navigation">
    <ul class="app-nav-list flex-wrap">
      <li class="app-nav-item">
        <a href="/" class="app-nav-link <%= shellHomeActive ? 'app-nav-link--active' : '' %>" <% if (shellHomeActive) { %>aria-current="page"<% } %>>
          <%- include('icon', { name: 'home' }) %>
          <span class="app-nav-label">Home</span>
        </a>
      </li>
      <li class="app-nav-item">
        <a href="/community" class="app-nav-link <%= shellCommunityActive ? 'app-nav-link--active' : '' %>" <% if (shellCommunityActive) { %>aria-current="page"<% } %>>
          <%- include('icon', { name: 'community' }) %>
          <span class="app-nav-label">Community</span>
        </a>
      </li>
      <li class="app-nav-item">
        <a href="/community/threads" class="app-nav-link <%= shellThreadsActive ? 'app-nav-link--active' : '' %>" <% if (shellThreadsActive) { %>aria-current="page"<% } %>>
          <%- include('icon', { name: 'threads' }) %>
          <span class="app-nav-label">Threads</span>
        </a>
      </li>
      <li class="app-nav-item">
        <% if (hiveSession) { %>
          <a href="/profile/<%= hiveSession.account %>" class="app-nav-link <%= shellYouActive ? 'app-nav-link--active' : '' %>" <% if (shellYouActive) { %>aria-current="page"<% } %>>
            <%- include('icon', { name: 'user' }) %>
            <span class="app-nav-label">You</span>
          </a>
        <% } else { %>
          <details id="hive-sign-in" class="app-nav-signin">
            <summary class="app-nav-link">
              <%- include('icon', { name: 'user' }) %>
              <span class="app-nav-label">Sign in</span>
            </summary>
            <form class="app-signin__panel" data-keychain-login>
              <label for="hive-login-account" class="app-field-label">Hive account</label>
              <input
                id="hive-login-account"
                name="account"
                type="text"
                required
                minlength="3"
                maxlength="64"
                autocomplete="username"
                autocapitalize="none"
                spellcheck="false"
                placeholder="your-account"
                aria-describedby="hive-login-help hive-login-status"
                class="app-field-control">
              <button type="submit" class="button-primary mt-3 w-full text-sm">Continue with Keychain</button>
              <p id="hive-login-help" class="app-field-hint">
                Use the
                <a class="underline hover:text-bar-gold" href="https://hive-keychain.com" rel="noopener noreferrer">Hive Keychain extension</a>
                to verify your Hive account by signing a login message. This does not send a transaction. Never enter a private key here.
              </p>
              <p class="app-field-hint">
                New to Hive? <a class="underline hover:text-bar-gold" href="/create-account">Create an account at 4th Street Bar.</a>
              </p>
              <p id="hive-login-status" class="app-field-hint min-h-5" role="status" aria-live="polite" data-keychain-status></p>
            </form>
          </details>
        <% } %>
      </li>
    </ul>
  </nav>

  <div class="app-account">
    <% if (hiveSession) { %>
      <div class="app-account__signed-in">
        <a href="/profile/<%= hiveSession.account %>" class="app-account__identity">
          <span class="app-account__avatar" aria-hidden="true"><%= hiveSession.account.slice(0, 1).toUpperCase() %></span>
          <span class="min-w-0">
            <strong class="block truncate">@<%= hiveSession.account %></strong>
            <span class="block text-xs text-gray-400">Signed in with Hive Keychain</span>
          </span>
        </a>
        <button type="button" class="app-signout" data-keychain-logout>Sign out</button>
      </div>
      <p class="app-account__status" aria-live="polite" data-keychain-status></p>
    <% } else { %>
      <p class="app-account__signed-out">Browse freely. Sign in only when you want to participate.</p>
    <% } %>
  </div>

  <p class="app-technology-attribution">
    <span>Hive-Bar</span>
    <span aria-hidden="true">·</span>
    <span>Powered by Hive</span>
  </p>
</header>
