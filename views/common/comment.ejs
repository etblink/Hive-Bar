<%
  const commentPresentation = typeof commentContext === 'string' && commentContext === 'thread'
    ? 'thread'
    : 'conversation';
  const visualDepth = Math.min(4, comment.depth || 0);
%>
<article
  class="comment-card social-comment social-comment--<%= commentPresentation %> comment-depth-<%= visualDepth %>"
  data-comment-depth="<%= visualDepth %>">
  <header class="social-author">
    <img src="<%= userProfile?.profileImage || `https://images.hive.blog/u/${comment.author}/avatar` %>" alt="" class="h-10 w-10 shrink-0 rounded-full bg-gray-800" width="40" height="40" loading="lazy">
    <div class="social-author__text">
      <a href="/profile/<%= comment.author %>" class="social-author__name"><%= userProfile?.displayName || `@${comment.author}` %></a>
      <div class="social-author__meta"><span>@<%= comment.author %></span><span aria-hidden="true">·</span><time datetime="<%= comment.created %>"><%= formatHiveDate(comment.created) %></time></div>
    </div>
  </header>
  <div class="social-comment__body prose max-w-none break-words text-gray-200"><%- comment.bodyHtml %></div>
  <div class="social-comment__activity">
    <footer class="social-comment__stats" aria-label="Comment activity">
      <span><%= comment.positiveVotes.toLocaleString() %> upvotes</span>
      <% if (comment.negativeVotes > 0) { %><span><%= comment.negativeVotes.toLocaleString() %> downvotes</span><% } %>
      <span class="text-bar-gold">$<%= formatPayout(comment) %></span>
    </footer>
    <div class="social-action-row social-action-row--comment" role="group" aria-label="Comment vote actions">
      <%- include('vote-form', { item: comment }) %>
    </div>
  </div>

  <% if (hiveSession && canWriteAction('comment')) { %>
    <%- include('composer', { composer: {
      id: `reply-composer-${comment.author}-${comment.permlink}`,
      controller: 'social',
      action: 'comment',
      signerMode,
      dialog: true,
      triggerLabel: 'Reply',
      triggerVariant: 'social',
      headingLevel: 3,
      kicker: 'Reply',
      title: `Reply to @${comment.author}`,
      description: 'Add to this conversation.',
      imageAttachment: true,
      hiddenFields: [
        { name: 'parentAuthor', value: comment.author },
        { name: 'parentPermlink', value: comment.permlink },
      ],
      fields: [
        { id: `reply-${comment.author}-${comment.permlink}`, name: 'body', type: 'textarea', label: 'Your reply', required: true, maxBytes: 8192, rows: 4, size: 'compact', placeholder: `Reply to @${comment.author}` },
      ],
      submitLabel: 'Review reply',
      submitVariant: 'secondary',
      disclosure: 'You’ll review this reply and attached image URL before Hive Keychain asks you to approve it.',
    } }) %>
  <% } %>
</article>
