<article class="comment-card social-comment comment-depth-<%= Math.min(4, comment.depth || 0) %>">
  <header class="social-author">
    <img
      src="<%= userProfile?.profileImage || `https://images.hive.blog/u/${comment.author}/avatar` %>"
      alt=""
      class="h-10 w-10 shrink-0 rounded-full bg-gray-800"
      width="40"
      height="40"
      loading="lazy">
    <div class="social-author__text">
      <a href="/profile/<%= comment.author %>" class="social-author__name">
        <%= userProfile?.displayName || `@${comment.author}` %>
      </a>
      <div class="social-author__meta">
        <span>@<%= comment.author %></span>
        <span aria-hidden="true">·</span>
        <time datetime="<%= comment.created %>"><%= formatHiveDate(comment.created) %></time>
      </div>
    </div>
  </header>
  <div class="prose max-w-none break-words text-gray-200">
    <%- comment.bodyHtml %>
  </div>
  <footer class="social-comment__stats" aria-label="Comment activity">
    <span><%= comment.positiveVotes.toLocaleString() %> positive votes</span>
    <% if (comment.negativeVotes > 0) { %><span><%= comment.negativeVotes.toLocaleString() %> downvotes</span><% } %>
    <span class="text-bar-gold">$<%= formatPayout(comment) %></span>
  </footer>
  <%- include('vote-form', { item: comment }) %>
</article>
