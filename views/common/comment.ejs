<article class="mb-4 rounded-lg border-b border-gray-600 bg-gray-700 p-4">
  <header class="mb-4 flex items-center">
    <img src="https://images.hive.blog/u/<%= comment.author %>/avatar" alt="" class="mr-4 h-10 w-10 rounded-full" width="40" height="40" loading="lazy">
    <div>
      <a href="/profile/<%= comment.author %>" class="text-lg font-semibold text-bar-gold hover:underline">@<%= comment.author %></a>
      <p class="text-sm text-gray-400"><%= new Date(comment.created).toLocaleString() %></p>
    </div>
  </header>
  <div class="prose prose-invert max-w-none break-words">
    <%- comment.parsedBody %>
  </div>
  <footer class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
    <span class="text-gray-300"><%= Number(comment.likes || 0).toLocaleString() %> positive votes</span>
    <span class="text-bar-gold">Pending: $<%= formatPayout(comment) %></span>
  </footer>
</article>
